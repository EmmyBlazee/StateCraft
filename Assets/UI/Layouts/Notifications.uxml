<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    <ui:VisualElement name="NotificationStack" style="position: absolute; right: 20px; top: 80px; width: 420px; padding: 10px; pointer-events: none;">
        <!-- Container for dynamic notification cards -->
    </ui:VisualElement>

    <ui:VisualElement name="NotificationHistoryModal" class="glass-panel hologram-border" style="display: none; position: absolute; right: 460px; top: 80px; bottom: 120px; width: 450px; background-color: rgba(10, 15, 22, 0.98); border-width: 1px; border-color: rgba(0,255,255,0.2); padding: 15px; pointer-events: auto;">
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 15px; border-bottom-width: 1px; border-color: rgba(255,255,255,0.1); padding-bottom: 10px;">
            <ui:Label text="NOTIFICATION HISTORY" style="color: white; font-size: 14px; -unity-font-style: bold; letter-spacing: 1px;" />
            <ui:Button name="BtnCloseHistory" text="×" class="econ-icon-button" style="width: 20px; height: 20px; font-size: 16px; margin: 0; padding: 0;" />
        </ui:VisualElement>
        <ui:ScrollView name="HistoryScrollView" mode="Vertical" style="flex-grow: 1;">
            <!-- History items go here -->
        </ui:ScrollView>
        <ui:Button name="BtnClearHistory" text="CLEAR HISTORY" class="modern-button" style="margin-top: 10px;" />
    </ui:VisualElement>
</ui:UXML>
