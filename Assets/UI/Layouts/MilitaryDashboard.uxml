<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    <ui:Template name="Template_Forces" src="project://database/Assets/UI/Layouts/MilitaryDashboard_Forces.uxml" />
    <ui:Template name="Template_Recruit" src="project://database/Assets/UI/Layouts/MilitaryDashboard_Recruit.uxml" />
    <ui:Template name="Template_Weapons" src="project://database/Assets/UI/Layouts/MilitaryDashboard_Weapons.uxml" />
    <ui:Template name="Template_Bases" src="project://database/Assets/UI/Layouts/MilitaryDashboard_Bases.uxml" />
    <ui:Template name="Template_Operations" src="project://database/Assets/UI/Layouts/MilitaryDashboard_Operations.uxml" />
    <ui:Template name="Template_Logistics" src="project://database/Assets/UI/Layouts/MilitaryDashboard_Logistics.uxml" />
    <ui:Template name="Template_Budget" src="project://database/Assets/UI/Layouts/MilitaryDashboard_Budget.uxml" />
    <ui:Template name="Template_Projects" src="project://database/Assets/UI/Layouts/MilitaryDashboard_Projects.uxml" />
    <ui:VisualElement name="MilitaryDashboard" class="standard-dashboard hologram-border" style="display: none; flex-direction: column; background-color: rgb(10, 14, 20);">

        <!-- TOP HEADER BAR (styled identically to Economy topbar) -->
        <ui:VisualElement name="Header" class="econ-topbar">
            <ui:VisualElement class="econ-country-block">
                <ui:VisualElement>
                    <ui:VisualElement class="econ-country-line">
                        <ui:Label name="CountryName" text="NIGERIA" class="econ-country-name" />
                        <ui:VisualElement name="CountryCoatOfArms" class="econ-flag" />
                    </ui:VisualElement>
                    <ui:Label name="ThreatLevelBadge" text="PEACE" class="econ-country-subtitle" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="econ-kpi-strip">
                <ui:VisualElement class="econ-kpi"><ui:Label text="TREASURY" class="econ-kpi-label" /><ui:Label name="HdrTreasury" text="—" class="econ-kpi-value" /><ui:Label name="HdrTreasuryMoM" text="+₦0B" class="econ-kpi-delta positive" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="GDP" class="econ-kpi-label" /><ui:Label name="HdrGDP" text="—" class="econ-kpi-value" /><ui:Label name="HdrGDPYoY" text="—" class="econ-kpi-delta positive" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="INFLATION" class="econ-kpi-label" /><ui:Label name="HdrInflation" text="—" class="econ-kpi-value" /><ui:Label name="HdrInflationMoM" text="+0.0% MoM" class="econ-kpi-delta negative" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="NATIONAL DEBT" class="econ-kpi-label" /><ui:Label name="HdrDebt" text="—" class="econ-kpi-value" /><ui:Label name="HdrDebtGDP" text="Debt / GDP" class="econ-kpi-delta warning" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="FX RATE" class="econ-kpi-label" /><ui:Label name="HdrFX" text="—" class="econ-kpi-value" /><ui:Label name="HdrFXChange" text="-₦0" class="econ-kpi-delta negative" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="APPROVAL" class="econ-kpi-label" /><ui:Label name="HdrApproval" text="—" class="econ-kpi-value" /><ui:Label name="HdrApprovalChange" text="+0% MoM" class="econ-kpi-delta positive" /></ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="econ-date-box" style="flex-direction: row; align-items: center;">
                <ui:Label name="ShortageAlertBadge" text="WEAPONS SHORTAGE" style="font-size: 12px; color: rgb(255,82,82); border-width:1px; border-color: rgb(255,82,82); padding: 2px 8px; border-radius: 4px; -unity-font-style: bold; margin-right: 10px; display: none;" />
                <ui:VisualElement>
                    <ui:Label name="HdrDate" text="08 JAN 2026" class="econ-date-main" />
                    <ui:Label name="HdrDay" text="Thursday, 09:12" class="econ-date-sub" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:Button name="BtnSettings" text="⚙" class="econ-icon-button" style="margin-right: 5px;" />
            <ui:Button name="CloseMilitary" text="×" class="econ-icon-button" />
        </ui:VisualElement>

        <!-- MILITARY SUB-TAB NAVIGATION -->
        <ui:VisualElement name="SubTabs" style="flex-direction: row; background-color: rgb(10, 14, 20); padding: 0; border-bottom-width: 1px; border-bottom-color: rgba(0, 210, 255, 0.15); width: 100%;">
            <ui:Button name="TabForces"     text="FORCES"      class="nav-button active-tab" style="flex-grow: 1; flex-shrink: 1; flex-basis: 0; padding-left: 5px; padding-right: 5px; height: 36px; font-size: 15px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis;" />
            <ui:Button name="TabRecruit"    text="RECRUITMENT" class="nav-button"             style="flex-grow: 1; flex-shrink: 1; flex-basis: 0; padding-left: 5px; padding-right: 5px; height: 36px; font-size: 15px; overflow: hidden; text-overflow: ellipsis;" />
            <ui:Button name="TabWeapons"    text="WEAPONS &amp; EQUIPMENT"     class="nav-button"             style="flex-grow: 1; flex-shrink: 1; flex-basis: 0; padding-left: 5px; padding-right: 5px; height: 36px; font-size: 15px; overflow: hidden; text-overflow: ellipsis;" />
            <ui:Button name="TabBases"      text="BASES"       class="nav-button"             style="flex-grow: 1; flex-shrink: 1; flex-basis: 0; padding-left: 5px; padding-right: 5px; height: 36px; font-size: 15px; overflow: hidden; text-overflow: ellipsis;" />
            <ui:Button name="TabOperations" text="OPERATIONS"  class="nav-button"             style="flex-grow: 1; flex-shrink: 1; flex-basis: 0; padding-left: 5px; padding-right: 5px; height: 36px; font-size: 15px; overflow: hidden; text-overflow: ellipsis;" />
            <ui:Button name="TabLogistics"  text="LOGISTICS"   class="nav-button"             style="flex-grow: 1; flex-shrink: 1; flex-basis: 0; padding-left: 5px; padding-right: 5px; height: 36px; font-size: 15px; overflow: hidden; text-overflow: ellipsis;" />
            <ui:Button name="TabBudget"     text="BUDGET"      class="nav-button"             style="flex-grow: 1; flex-shrink: 1; flex-basis: 0; padding-left: 5px; padding-right: 5px; height: 36px; font-size: 15px; overflow: hidden; text-overflow: ellipsis;" />
        </ui:VisualElement>

        <!-- CONTENT PANELS -->
        <ui:VisualElement name="PanelContainer" style="flex-grow: 1; flex-direction: column; overflow: hidden;">

            <!-- 1. FORCES TAB  (visible by default) -->
            <ui:Instance template="Template_Forces" name="PanelForcesInstance" />

            <!-- 2. RECRUITMENT TAB -->
            <ui:Instance template="Template_Recruit" name="PanelRecruitInstance" />

            <!-- 3. WEAPONS TAB -->
            <ui:Instance template="Template_Weapons" name="PanelWeaponsInstance" />

            <!-- 4. BASES TAB -->
            <ui:Instance template="Template_Bases" name="PanelBasesInstance" />

            <!-- 5. OPERATIONS TAB -->
            <ui:Instance template="Template_Operations" name="PanelOperationsInstance" />

            <!-- 6. LOGISTICS TAB -->
            <ui:Instance template="Template_Logistics" name="PanelLogisticsInstance" />

            <!-- 7. BUDGET TAB -->
            <ui:Instance template="Template_Budget" name="PanelBudgetInstance" />

            <!-- 8. PROJECTS TAB -->
            <ui:Instance template="Template_Projects" name="PanelProjectsInstance" />

        </ui:VisualElement>
        <!-- /PanelContainer -->

       

     
           
    </ui:VisualElement>
</ui:UXML>
