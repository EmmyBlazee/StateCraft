<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    <ui:VisualElement name="MilitaryDashboard" class="standard-dashboard hologram-border" style="display: none; flex-direction: column;">

        
        <!-- HEADER -->
        <ui:VisualElement name="Header" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px; border-bottom-width: 1px; border-bottom-color: rgba(255, 82, 82, 0.3); padding-bottom: 8px;">
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:Label name="MilHeaderTitle" text="NATIONAL DEFENCE COMMAND" style="font-size: 24px; color: white; -unity-font-style: bold; letter-spacing: 2px; margin-right: 20px;" />
                <ui:Label name="ThreatLevelBadge" text="PEACE" style="font-size: 10px; color: rgb(0, 230, 118); border-width: 1px; border-color: rgb(0, 230, 118); padding: 2px 8px; border-radius: 4px; -unity-font-style: bold;" />
                <ui:Label name="ShortageAlertBadge" text="WEAPONS SHORTAGE" style="font-size: 10px; color: rgb(255, 82, 82); border-width: 1px; border-color: rgb(255, 82, 82); padding: 2px 8px; border-radius: 4px; -unity-font-style: bold; margin-left: 10px; display: none;" />
            </ui:VisualElement>
            
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:VisualElement style="align-items: flex-end; margin-right: 30px;">
                    <ui:Label text="WAR CASUALTIES" style="font-size: 9px; color: grey;" />
                    <ui:Label name="HeaderKIA" text="0 KIA | 0 WIA" style="font-size: 11px; color: rgb(255, 82, 82); -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="align-items: flex-end; margin-right: 30px;">
                    <ui:Label text="TOTAL DEFENCE BUDGET" style="font-size: 9px; color: grey;" />
                    <ui:Label name="HeaderMilBudget" text="₦12.5B / Turn" style="font-size: 11px; color: rgb(0, 210, 255); -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="align-items: flex-end; margin-right: 30px;">
                    <ui:Label text="OVERALL READINESS" style="font-size: 9px; color: grey;" />
                    <ui:Label name="HeaderReadiness" text="85%" style="font-size: 11px; color: rgb(241, 196, 15); -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:Button name="BtnInbox" text="COMMAND INBOX (0)" class="button-premium" style="width: 130px; height: 35px; border-radius: 4px; font-size: 10px; background-color: rgba(33,150,243,0.5); border-color: rgba(33,150,243,0.8); margin-right: 15px;" />
                <ui:Button name="CloseMilitary" text="×" class="button-premium" style="width: 40px; height: 40px; border-radius: 20px; font-size: 20px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- SUB-TAB NAVIGATION -->
        <ui:VisualElement name="SubTabs" style="flex-direction: row; margin-bottom: 6px; background-color: rgba(0,0,0,0.4); border-radius: 6px; padding: 2px;">
            <ui:Button name="TabForces" text="FORCES" class="nav-button active-tab" style="flex-grow: 1;" />
            <ui:Button name="TabRecruit" text="RECRUITMENT" class="nav-button" style="flex-grow: 1;" />
            <ui:Button name="TabWeapons" text="WEAPONS" class="nav-button" style="flex-grow: 1;" />
            <ui:Button name="TabBases" text="BASES" class="nav-button" style="flex-grow: 1;" />
            <ui:Button name="TabOperations" text="OPERATIONS" class="nav-button" style="flex-grow: 1;" />
            <ui:Button name="TabProjects" text="PROJECTS" class="nav-button" style="flex-grow: 1;" />
            <ui:Button name="TabLogistics" text="LOGISTICS" class="nav-button" style="flex-grow: 1;" />
            <ui:Button name="TabBudget" text="BUDGET" class="nav-button" style="flex-grow: 1;" />
        </ui:VisualElement>


        <!-- CONTENT PANELS -->
        <ui:VisualElement name="PanelContainer" style="flex-grow: 1; flex-direction: column; overflow: hidden;">
            
            <!-- 1. FORCES TAB -->
            <ui:VisualElement name="PanelForces" style="display: flex; height: 100%;">
                <ui:ScrollView style="flex-grow: 1;">
                    <!-- MILITARY POSTURE (INTEGRATED) -->
                    <ui:VisualElement class="sub-panel" style="margin-bottom: 8px; padding: 8px; border-width: 1px; border-color: rgba(0, 210, 255, 0.2);">
                        <ui:Label text="STANDING DEFENCE POSTURE" style="font-size: 11px; color: rgb(0, 210, 255); -unity-font-style: bold; margin-bottom: 6px; letter-spacing: 1px;" />
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                            <ui:VisualElement style="flex-direction: row; width: 60%; justify-content: space-between;">
                                <ui:Button name="BtnPostureDefensive" text="DEFENSIVE" class="button-premium" style="width: 23%; height: 30px; font-size: 8px;" />
                                <ui:Button name="BtnPostureDeterrence" text="DETERRENCE" class="button-premium" style="width: 23%; height: 30px; font-size: 8px;" />
                                <ui:Button name="BtnPostureOffensive" text="OFFENSIVE" class="button-premium" style="width: 23%; height: 30px; font-size: 8px;" />
                                <ui:Button name="BtnPostureCOIN" text="COIN FOCUS" class="button-premium" style="width: 23%; height: 30px; font-size: 8px;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="width: 38%; padding-left: 15px; border-left-width: 1px; border-left-color: rgba(255,255,255,0.15);">
                                <ui:Label name="DoctrineDesc" text="Select a posture to see operational impact." style="color: rgb(200,200,200); font-size: 9px; white-space: normal; -unity-font-style: italic;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- CHAIN OF COMMAND & BLOCKADES (PHASE 2) -->
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 8px;">
                        <ui:VisualElement class="sub-panel" style="width: 48%; padding: 8px;">
                            <ui:Label text="CHAIN OF COMMAND (GENERALS)" style="font-size: 11px; color: rgb(241, 196, 15); -unity-font-style: bold; margin-bottom: 6px;" />
                            <ui:ScrollView name="GeneralsContainer" style="max-height: 150px;" />
                            <ui:Button name="BtnRecruitGeneral" text="PROMOTE NEW GENERAL (₦250M)" class="button-premium" style="margin-top: 6px; height: 30px; font-size: 9px;" />
                        </ui:VisualElement>

                        <ui:VisualElement class="sub-panel" style="width: 48%; padding: 8px;">
                            <ui:Label text="NAVAL BLOCKADE COMMAND" style="font-size: 11px; color: rgb(33, 150, 243); -unity-font-style: bold; margin-bottom: 6px;" />
                            <ui:ScrollView name="BlockadesContainer" style="max-height: 150px;" />
                            <ui:Button name="BtnDeclareBlockade" text="ORDER NEW BLOCKADE" class="button-premium" style="margin-top: 6px; height: 30px; font-size: 9px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="BranchContainer" style="flex-direction: row; flex-wrap: wrap; justify-content: space-between;" />
                    <ui:VisualElement name="InternalSecurityContainer" class="sub-panel" style="margin-top: 8px; padding: 8px;">
                        <ui:Label text="POLICE &amp; INTERNAL SECURITY" style="font-size: 11px; color: rgb(255, 235, 59); -unity-font-style: bold; margin-bottom: 8px;" />
                        <ui:VisualElement name="RegionPoliceList" style="flex-direction: row; flex-wrap: wrap;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="GlobalPowerBalanceContainer" class="sub-panel" style="margin-top: 8px; padding: 8px;">
                        <ui:Label text="GLOBAL MILITARY FIREPOWER INDEX (BALANCE OF POWER)" style="font-size: 11px; color: rgb(255, 82, 82); -unity-font-style: bold; margin-bottom: 8px;" />
                        <ui:ScrollView name="GlobalPowerList" style="flex-direction: column; max-height: 250px;" />
                    </ui:VisualElement>

                    <!-- STRATEGIC DETERRENCE (WMD) -->
                    <ui:VisualElement class="sub-panel" style="margin-top: 8px; padding: 8px;">
                        <ui:Label text="STRATEGIC DETERRENCE &amp; W.M.D. PROGRAM" style="font-size: 11px; color: rgb(0, 210, 255); -unity-font-style: bold; margin-bottom: 8px;" />
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                            <ui:VisualElement style="width: 70%;">
                                <ui:Label text="WMD DEVELOPMENT PROGRESS" style="font-size: 10px; color: grey; margin-bottom: 5px;" />
                                <ui:ProgressBar name="WMDProgressBar" value="0" style="height: 12px; margin-bottom: 5px;" />
                                <ui:Label name="WMDStatusLabel" text="Inactive" style="font-size: 10px; color: rgb(255, 235, 59);" />
                            </ui:VisualElement>
                            <ui:VisualElement style="width: 25%; align-items: flex-end;">
                                <ui:Label name="WMDOperationalBadge" text="NUCLEAR SECURED" style="font-size: 10px; color: rgb(0, 255, 0); border-width: 1px; border-color: rgb(0, 255, 0); padding: 4px; display: none;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="live-feed-panel" style="margin-top: 8px;">
                        <ui:Label text="DEFENCE SITREP" class="live-feed-title" />
                        <ui:Label name="MilBriefing" text="Awaiting theatre reports…" class="live-feed-briefing" />
                        <ui:ScrollView name="MilLiveFeed" style="max-height: 100px;" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- 2. RECRUITMENT TAB -->
            <ui:VisualElement name="PanelRecruit" style="display: none; height: 100%;">
                <ui:VisualElement style="flex-direction: column; height: 100%;">
                    <ui:Label text="PERSONNEL RECRUITMENT &amp; TRAINING" style="font-size: 11px; color: rgb(0, 210, 255); -unity-font-style: bold; margin-bottom: 8px;" />
                    <ui:ScrollView style="flex-grow: 1;">
                        <ui:VisualElement name="PersonnelGrid" style="flex-direction: row; flex-wrap: wrap; justify-content: space-between;" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 2b. WEAPONS TAB -->
            <ui:VisualElement name="PanelWeapons" style="display: none; height: 100%;">
                <ui:VisualElement style="flex-direction: column; height: 100%;">
                    <ui:Label text="WEAPONS INFRASTRUCTURE" style="font-size: 11px; color: rgb(255, 82, 82); -unity-font-style: bold; margin-bottom: 8px;" />
                    <ui:ScrollView style="flex-grow: 1;">
                        <ui:VisualElement name="WeaponsGrid" style="flex-direction: row; flex-wrap: wrap; justify-content: space-between;" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 2c. BASES TAB -->
            <ui:VisualElement name="PanelBases" style="display: none; height: 100%;">
                <ui:VisualElement style="flex-direction: column; height: 100%;">
                    <ui:Label text="STRATEGIC BRANCH BASE CONSTRUCTIONS" style="font-size: 11px; color: rgb(0, 230, 118); -unity-font-style: bold; margin-bottom: 8px;" />
                    <ui:ScrollView style="flex-grow: 1;">
                        <ui:VisualElement name="BasesGrid" style="flex-direction: row; flex-wrap: wrap; justify-content: space-between;" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 3. OPERATIONS TAB -->
            <ui:VisualElement name="PanelOperations" style="display: none; flex-grow: 1; flex-direction: row; min-height: 0; overflow: hidden; padding: 6px;">
                <ui:VisualElement name="col-left" style="width: 24%; min-width: 200px; max-width: 280px; flex-shrink: 0; flex-direction: column; margin-right: 8px; min-height: 0;">

                    <!-- Threat Status -->
                    <ui:VisualElement name="panel-threat" class="ops-panel" style="flex-grow: 1; margin-bottom: 6px;">
                        <ui:Label text="THREAT STATUS" class="ops-panel__title"/>
                        <ui:ScrollView name="threat-list" style="flex-grow: 1;"/>
                        <ui:Button name="btn-view-regions" text="VIEW ALL REGIONS &gt;" class="ops-btn-link"/>
                    </ui:VisualElement>

                    <!-- Intelligence Assessment -->
                    <ui:VisualElement name="panel-intel" class="ops-panel" style="flex-shrink: 0;">
                        <ui:Label text="INTELLIGENCE ASSESSMENT" class="ops-panel__title"/>
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                            <ui:VisualElement class="intel-icon intel-icon--danger">
                                <ui:Label text="!" class="intel-icon__glyph"/>
                            </ui:VisualElement>
                            <ui:Label name="lbl-intel-region" text="AWAITING INTEL" class="intel-region-name" style="margin-left: 10px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="intel-grid">
                            <ui:VisualElement class="intel-row"><ui:Label text="Threat Level:" class="intel-key"/><ui:Label name="lbl-threat-level" text="-" class="intel-val intel-val--danger"/></ui:VisualElement>
                            <ui:VisualElement class="intel-row"><ui:Label text="Strength:" class="intel-key"/><ui:Label name="lbl-enemy-strength" text="-" class="intel-val"/></ui:VisualElement>
                            <ui:VisualElement class="intel-row"><ui:Label text="Confidence:" class="intel-key"/><ui:Label name="lbl-confidence" text="-" class="intel-val"/></ui:VisualElement>
                            <ui:VisualElement class="intel-row"><ui:Label text="Source:" class="intel-key"/><ui:Label name="lbl-intel-source" text="-" class="intel-val"/></ui:VisualElement>
                            <ui:VisualElement class="intel-row"><ui:Label text="Updated:" class="intel-key"/><ui:Label name="lbl-last-updated" text="-" class="intel-val"/></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Button name="btn-view-intel" text="VIEW INTEL REPORT &gt;" class="ops-btn-link"/>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- CENTER COLUMN -->
                <ui:VisualElement name="col-center" style="flex-grow: 1; flex-direction: column; margin-right: 8px; min-height: 0; min-width: 0;">

                    <!-- Active Operations -->
                    <ui:VisualElement name="panel-active-ops" class="ops-panel" style="flex-grow: 1; margin-bottom: 6px;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <ui:Label text="ACTIVE OPERATIONS" class="ops-panel__title" style="margin-bottom: 0;"/>
                            <ui:Button name="btn-view-all-ops" text="VIEW ALL OPERATIONS &gt;" class="ops-btn-link" style="margin-top: 0;"/>
                        </ui:VisualElement>
                        <ui:ScrollView name="ops-list" style="flex-grow: 1;"/>
                        <ui:Button name="btn-launch-new" class="ops-btn-launch-new">
                            <ui:Label text="+  LAUNCH NEW OPERATION" class="ops-btn-launch-new__label"/>
                        </ui:Button>
                    </ui:VisualElement>

                    <!-- Operation Feed -->
                    <ui:VisualElement name="panel-feed" class="ops-panel" style="min-height: 160px; max-height: 35%; flex-shrink: 0;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <ui:Label text="OPERATION FEED" class="ops-panel__title" style="margin-bottom: 0;"/>
                            <ui:Button name="btn-view-feed" text="VIEW FULL FEED &gt;" class="ops-btn-link" style="margin-top: 0;"/>
                        </ui:VisualElement>
                        <ui:ScrollView name="feed-list" style="flex-grow: 1;"/>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- RIGHT COLUMN -->
                <ui:VisualElement name="col-right" style="width: 26%; min-width: 230px; max-width: 310px; flex-shrink: 0; flex-direction: column; min-height: 0;">

                    <!-- Launch New Operation -->
                    <ui:VisualElement name="panel-launch" class="ops-panel" style="flex-grow: 1; margin-bottom: 6px;">
                        <ui:Label text="LAUNCH NEW OPERATION" class="ops-panel__title"/>
                        <ui:ScrollView name="op-types-scroll" style="flex-grow: 1;">
                            <ui:VisualElement name="op-types-grid" style="flex-direction: column;"/>
                        </ui:ScrollView>
                        <ui:Button name="btn-view-op-types" text="VIEW ALL OPERATION TYPES &gt;" class="ops-btn-link"/>
                    </ui:VisualElement>

                    <!-- Force Readiness -->
                    <ui:VisualElement name="panel-readiness" class="ops-panel" style="flex-shrink: 0;">
                        <ui:Label text="FORCE READINESS" class="ops-panel__title"/>
                        <ui:VisualElement name="readiness-list" style="flex-direction: column;"/>
                        <ui:Button name="btn-view-force" text="VIEW FORCE DETAILS &gt;" class="ops-btn-link"/>
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- 4. PROJECTS TAB -->
            <ui:VisualElement name="PanelProjects" style="display: none; height: 100%;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; height: 100%;">
                    <!-- Active Projects -->
                    <ui:VisualElement style="width: 45%; height: 100%;">
                        <ui:Label text="ACTIVE STRATEGIC PROJECTS" style="font-size: 11px; color: rgb(0, 210, 255); -unity-font-style: bold; margin-bottom: 8px;" />
                        <ui:ScrollView name="ActiveProjectsList" mode="Vertical" show-horizontal-scroller="False" style="flex-grow: 1;" />
                    </ui:VisualElement>
                    <!-- Available Projects -->
                    <ui:VisualElement style="width: 53%; height: 100%;">
                        <ui:Label text="STRATEGIC RESEARCH &amp; PROCUREMENT DIRECTIVES" style="font-size: 11px; color: rgb(0, 210, 255); -unity-font-style: bold; margin-bottom: 8px;" />
                        <ui:ScrollView name="AvailableProjectsList" mode="Vertical" show-horizontal-scroller="False" style="flex-grow: 1;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- 5. LOGISTICS TAB -->
            <ui:VisualElement name="PanelLogistics" style="display: none; height: 100%;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; height: 100%;">
                    <!-- Stockpiles -->
                    <ui:VisualElement style="width: 32%; height: 100%;">
                        <ui:Label text="STRATEGIC RESERVES" style="font-size: 11px; color: rgb(0, 210, 255); -unity-font-style: bold; margin-bottom: 8px;" />
                        <ui:ScrollView mode="Vertical" show-horizontal-scroller="False" style="flex-grow: 1;">
                            <ui:VisualElement class="sub-panel" style="padding: 6px; margin-bottom: 6px; flex-shrink: 0;">
                                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                    <ui:Label text="FUEL RESERVES" class="metric-label" style="margin-bottom: 4px;" />
                                    <ui:Label name="NatFuelStock" text="Nat. Stock: 0bbl" style="font-size: 8px; color: grey;" />
                                </ui:VisualElement>
                                <ui:ProgressBar name="FuelBar" value="85" style="height: 8px;" />
                                <ui:Button name="BtnBuyFuel" text="SECURE FUEL IMPORTS" class="button-premium" style="height: 22px; font-size: 8px; margin-top: 8px;" />
                            </ui:VisualElement>
                            <ui:VisualElement class="sub-panel" style="padding: 6px; margin-bottom: 6px; flex-shrink: 0;">
                                <ui:Label text="AMMUNITION" class="metric-label" style="margin-bottom: 4px;" />
                                <ui:ProgressBar name="AmmoBar" value="60" style="height: 8px;" />
                                <ui:Button name="BtnBuyAmmo" text="BUY MUNITIONS" class="button-premium" style="height: 22px; font-size: 8px; margin-top: 8px;" />
                            </ui:VisualElement>
                            <ui:VisualElement class="sub-panel" style="padding: 6px; margin-bottom: 6px; flex-shrink: 0;">
                                <ui:Label text="MEDICAL SUPPLIES" class="metric-label" style="margin-bottom: 4px;" />
                                <ui:ProgressBar name="MedicalBar" value="45" style="height: 8px;" />
                                <ui:Button name="BtnBuyMedical" text="BUY MED SUPPLIES" class="button-premium" style="height: 22px; font-size: 8px; margin-top: 8px;" />
                            </ui:VisualElement>
                            <ui:VisualElement class="sub-panel" style="padding: 6px; margin-bottom: 6px; flex-shrink: 0;">
                                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                    <ui:Label text="FOOD RATIONS" class="metric-label" style="margin-bottom: 4px;" />
                                    <ui:Label name="NatFoodStock" text="Nat. Stock: 0T" style="font-size: 8px; color: grey;" />
                                </ui:VisualElement>
                                <ui:ProgressBar name="FoodBar" value="95" style="height: 8px;" />
                                <ui:Button name="BtnBuyFood" text="PROCURE FOOD RATIONS" class="button-premium" style="height: 22px; font-size: 8px; margin-top: 8px;" />
                            </ui:VisualElement>
                            <ui:VisualElement class="sub-panel" style="padding: 6px; margin-bottom: 6px; flex-shrink: 0;">
                                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                    <ui:Label text="MILITARY GRID (ELEC)" class="metric-label" style="margin-bottom: 4px;" />
                                    <ui:Label name="NatElecStock" text="National Grid: 0%" style="font-size: 8px; color: grey;" />
                                </ui:VisualElement>
                                <ui:ProgressBar name="ElecBar" value="100" style="height: 8px;" />
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <!-- Supply Routes -->
                    <ui:VisualElement style="width: 65%; height: 100%;">
                        <ui:Label text="SUPPLY LINE HEALTH" style="font-size: 11px; color: rgb(0, 210, 255); -unity-font-style: bold; margin-bottom: 8px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 6. BUDGET BREAKDOWN TAB -->
            <ui:VisualElement name="PanelBudget" style="display: none; height: 100%;">
                <ui:VisualElement style="flex-direction: column; height: 100%;">
                    <ui:Label text="DEFENCE BUDGET BREAKDOWN" style="font-size: 11px; color: rgb(255, 82, 82); -unity-font-style: bold; margin-bottom: 8px;" />
                    <ui:Label text="Estimated expenditures calculated functionally by active standing assets (Excludes situational operations drain)" style="font-size: 9px; color: grey; margin-bottom: 6px;" />
                    <ui:ScrollView name="BudgetLedgerList" mode="Vertical" show-horizontal-scroller="False" style="flex-grow: 1;" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
