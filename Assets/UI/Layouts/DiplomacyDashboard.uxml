<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    <ui:VisualElement name="DiplomacyDashboard" class="standard-dashboard hologram-border" style="display: none;">

        <!-- HEADER -->
        <ui:VisualElement name="Header" class="econ-topbar">
            <ui:VisualElement class="econ-country-block">
                <ui:VisualElement>
                    <ui:VisualElement class="econ-country-line">
                        <ui:Label name="DiplomacyHeaderTitle" text="FOREIGN AFFAIRS" class="econ-country-name" />
                        <ui:VisualElement class="econ-flag" />
                    </ui:VisualElement>
                    <ui:Label name="GlobalPrestigeScore" text="PRESTIGE: 50/100" class="econ-country-subtitle" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="econ-kpi-strip">
                <ui:VisualElement class="econ-kpi"><ui:Label text="ALLIES" class="econ-kpi-label" /><ui:Label name="HeaderAlliesCount" text="6" class="econ-kpi-value" /><ui:Label text="Treaties" class="econ-kpi-delta positive" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="RIVALS" class="econ-kpi-label" /><ui:Label name="HeaderRivalsCount" text="2" class="econ-kpi-value" /><ui:Label text="Hostile" class="econ-kpi-delta negative" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="NEUTRAL" class="econ-kpi-label" /><ui:Label name="HeaderNeutralCount" text="45" class="econ-kpi-value" /><ui:Label text="Global" class="econ-kpi-delta" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="INFLUENCE" class="econ-kpi-label" /><ui:Label name="HeaderInfluenceVal" text="71%" class="econ-kpi-value" /><ui:Label text="Rising" class="econ-kpi-delta positive" /></ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="econ-date-box">
                <ui:Label name="DateMain" text="08 JAN 2026" class="econ-date-main" />
                <ui:Label name="DateSub" text="Thursday, 09:12" class="econ-date-sub" />
            </ui:VisualElement>
            <ui:Button name="CloseDiplomacy" text="×" class="econ-icon-button" />
        </ui:VisualElement>

        <!-- SUB-TAB NAVIGATION -->
        <ui:VisualElement name="SubTabs" style="flex-direction: row; margin-bottom: 8px; background-color: rgba(0,0,0,0.4); border-radius: 8px; padding: 5px;">
            <ui:Button name="TabOverview" text="OVERVIEW" class="nav-button active-tab" style="flex-grow: 1;" />
            <ui:Button name="TabBilateral" text="BILATERAL RELATIONS" class="nav-button" style="flex-grow: 1;" />
            <ui:Button name="TabTreaties" text="TREATIES &amp; AGREEMENTS" class="nav-button" style="flex-grow: 1;" />
            <ui:Button name="TabOrganizations" text="INTERNATIONAL ORGANIZATIONS" class="nav-button" style="flex-grow: 1;" />
            <ui:Button name="TabEmbassies" text="EMBASSIES" class="nav-button" style="flex-grow: 1;" />
        </ui:VisualElement>

        <!-- CONTENT PANELS -->
        <ui:VisualElement name="PanelContainer" style="flex-grow: 1;">
            
            <!-- 1. OVERVIEW TAB -->
            <ui:VisualElement name="PanelOverview" style="display: flex; height: 100%; flex-direction: row;">
                
                <!-- Left: Diplomatic Events -->
                <ui:VisualElement class="sub-panel" style="width: 45%; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                    <ui:Label text="RECENT DIPLOMATIC EVENTS" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                    <ui:ScrollView name="DipEventsList" style="flex-grow: 1;" />
                </ui:VisualElement>

                <!-- Right: Summary Cards -->
                <ui:VisualElement style="flex-grow: 1; flex-direction: column;">
                    
                    <!-- Current Treaties Summary -->
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-bottom: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="CURRENT TREATIES" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:VisualElement name="OverviewTreatiesList" style="flex-grow: 1;" />
                    </ui:VisualElement>

                    <!-- Organizations Summary -->
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-bottom: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="REGIONAL ORGANIZATIONS" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:VisualElement name="OverviewOrgsList" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap;" />
                    </ui:VisualElement>

                    <!-- Global Reputation Summary -->
                    <ui:VisualElement class="sub-panel" style="height: 120px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="GLOBAL REPUTATION" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label name="GlobalRepValue" text="Respectable" style="font-size: 18px; color: rgb(35, 237, 86); -unity-font-style: bold; margin-right: 12px;" />
                            <ui:Label name="GlobalRepDesc" text="The international community views your administration favorably due to strong economic ties and recent peacekeeping efforts." style="font-size: 12px; color: grey; white-space: normal; flex-grow: 1;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 2. BILATERAL RELATIONS TAB -->
            <ui:VisualElement name="PanelBilateral" style="display: none; height: 100%; flex-direction: column;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <ui:Label text="BILATERAL RELATIONS" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; letter-spacing: 1px;" />
                    <!-- Placeholder for search/filter if needed -->
                </ui:VisualElement>
                <ui:ScrollView style="flex-grow: 1;">
                    <ui:VisualElement name="BilateralCardsGrid" style="flex-direction: row; flex-wrap: wrap; justify-content: flex-start;" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- 3. TREATIES & AGREEMENTS TAB -->
            <ui:VisualElement name="PanelTreaties" style="display: none; height: 100%; flex-direction: column;">
                <ui:Label text="INTERNATIONAL TREATIES &amp; AGREEMENTS" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                <ui:ScrollView style="flex-grow: 1; margin-bottom: 12px;">
                    <ui:VisualElement name="TreatiesCardsList" style="flex-direction: column;" />
                </ui:ScrollView>
                <ui:VisualElement style="flex-direction: row; justify-content: center;">
                    <ui:Button name="BtnProposeTreaty" text="PROPOSE TREATY" class="button-premium" style="width: 250px; height: 36px; font-size: 14px; background-color: rgba(35, 140, 237, 0.3); border-color: rgb(35, 140, 237);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 4. INTERNATIONAL ORGANIZATIONS TAB -->
            <ui:VisualElement name="PanelOrganizations" style="display: none; height: 100%; flex-direction: column;">
                <ui:Label text="INTERNATIONAL ORGANIZATIONS" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                <ui:ScrollView style="flex-grow: 1;">
                    <ui:VisualElement name="OrganizationsCardsGrid" style="flex-direction: row; flex-wrap: wrap; justify-content: flex-start;" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- 5. EMBASSIES TAB -->
            <ui:VisualElement name="PanelEmbassies" style="display: none; height: 100%; flex-direction: column;">
                
                <!-- Embassies KPIs -->
                <ui:VisualElement style="flex-direction: row; margin-bottom: 16px;">
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); align-items: center;">
                        <ui:Label text="EMBASSIES ABROAD" style="font-size: 11px; color: grey; margin-bottom: 4px;" />
                        <ui:Label name="EmbTotal" text="45" style="font-size: 19px; -unity-font-style: bold; color: white;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); align-items: center;">
                        <ui:Label text="OPERATIONAL" style="font-size: 11px; color: grey; margin-bottom: 4px;" />
                        <ui:Label name="EmbOperational" text="39" style="font-size: 19px; -unity-font-style: bold; color: rgb(35, 237, 86);" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); align-items: center;">
                        <ui:Label text="CLOSED" style="font-size: 11px; color: grey; margin-bottom: 4px;" />
                        <ui:Label name="EmbClosed" text="6" style="font-size: 19px; -unity-font-style: bold; color: rgb(255, 82, 82);" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); align-items: center;">
                        <ui:Label text="EMBASSY BUDGET" style="font-size: 11px; color: grey; margin-bottom: 4px;" />
                        <ui:Label name="EmbBudget" text="₦1.2B" style="font-size: 19px; -unity-font-style: bold; color: rgb(241, 196, 15);" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:ScrollView style="flex-grow: 1;">
                    <ui:VisualElement name="EmbassiesCardsGrid" style="flex-direction: row; flex-wrap: wrap; justify-content: flex-start;" />
                </ui:ScrollView>

            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>