<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    <ui:VisualElement name="CountryInfoPanel" class="glass-panel hologram-border" style="width: 420px; padding: 20px; position: absolute; right: 0; top: 65px; bottom: 35px; border-right-width: 0; opacity: 0; display: none; pointer-events: none;">

        <!-- SCROLLABLE DOSSIER — everything except the close button scrolls -->
        <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Hidden" style="flex-grow: 1;">

            <!-- DOSSIER HEADER -->
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 15px; border-bottom-width: 1px; border-bottom-color: rgba(0,210,255,0.25); padding-bottom: 15px;">
                <ui:Image name="SelectedFlag" style="width: 55px; height: 37px; border-radius: 3px; margin-right: 15px; background-color: rgba(0,0,0,0.4);" />
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:Label name="CountryName" text="—" style="font-size: 21px; color: white; -unity-font-style: bold; letter-spacing: 2px;" />
                    <ui:Label name="GovernmentType" text="—" style="font-size: 12px; color: #90a4ae; letter-spacing: 1px; margin-top: 2px;" />
                    <ui:Label name="CapitalCity" text="—" style="font-size: 12px; color: #546e7a; letter-spacing: 1px;" />
                </ui:VisualElement>
                <ui:Label name="RelationBadge" text="NEUTRAL" style="font-size: 12px; color: #ffc107; -unity-font-style: bold; background-color: rgba(255,193,7,0.1); padding: 4px 8px; border-radius: 3px; border-width: 1px; border-color: rgba(255,193,7,0.3);" />
            </ui:VisualElement>

            <!-- INTEL STATUS BAR -->
            <ui:VisualElement style="background-color: rgba(255,193,7,0.05); padding: 8px 12px; border-radius: 3px; margin-bottom: 12px; border-width: 1px; border-color: rgba(255,193,7,0.2); flex-direction: row; justify-content: space-between;">
                <ui:Label name="IntelLevelText" text="INTEL LEVEL 1: SATELLITE RECON" style="font-size: 12px; color: #ffc107; -unity-font-style: bold;" />
                <ui:Label name="PopulationValue" text="POP: —" style="font-size: 12px; color: #546e7a;" />
            </ui:VisualElement>

            <!-- LATEST NEWS HEADLINE -->
            <ui:VisualElement name="CountryHeadlineBox" style="background-color: rgba(255, 152, 0, 0.08); border-width: 1px; border-color: rgba(255, 152, 0, 0.4); border-radius: 4px; padding: 8px 12px; margin-bottom: 12px;">
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 4px;">
                    <ui:Label text="▶ LATEST HEADLINE" style="font-size: 11px; color: rgb(255, 152, 0); -unity-font-style: bold; letter-spacing: 1px; flex-grow: 1;" />
                </ui:VisualElement>
                <ui:Label name="CountryHeadlineText" text="Monitoring global frequencies..." style="font-size: 12px; color: white; white-space: normal;" />
            </ui:VisualElement>

            <!-- ECONOMIC STATS -->
            <ui:Label text="◈ ECONOMIC PROFILE" style="font-size: 12px; color: rgb(0,210,255); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 8px;" />
            <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 14px; background-color: rgba(0,0,0,0.25); padding: 10px; border-radius: 4px;">
                <ui:VisualElement style="width: 48%; margin-bottom: 8px;">
                    <ui:Label text="GDP" style="font-size: 11px; color: #546e7a;" />
                    <ui:Label name="GdpValue" text="—" style="font-size: 15px; color: white; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 48%; margin-bottom: 8px;">
                    <ui:Label text="GDP GROWTH" style="font-size: 11px; color: #546e7a;" />
                    <ui:Label name="GdpGrowthValue" text="—" style="font-size: 15px; color: rgb(0,230,118); -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 48%; margin-bottom: 8px;">
                    <ui:Label text="INFLATION" style="font-size: 11px; color: #546e7a;" />
                    <ui:Label name="InflationValue" text="—" style="font-size: 15px; color: white;" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 48%; margin-bottom: 8px;">
                    <ui:Label text="DEBT / GDP" style="font-size: 11px; color: #546e7a;" />
                    <ui:Label name="DebtRatioValue" text="—" style="font-size: 15px; color: white;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- POLITICAL & STABILITY STATS -->
            <ui:Label text="◈ NATIONAL STABILITY" style="font-size: 12px; color: rgb(0,210,255); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 8px;" />
            <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 14px; background-color: rgba(0,0,0,0.25); padding: 10px; border-radius: 4px;">
                <ui:VisualElement style="width: 48%; margin-bottom: 8px;">
                    <ui:Label text="STABILITY" style="font-size: 11px; color: #546e7a;" />
                    <ui:Label name="StabilityValue" text="—" style="font-size: 15px; color: white; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 48%; margin-bottom: 8px;">
                    <ui:Label text="SECURITY" style="font-size: 11px; color: #546e7a;" />
                    <ui:Label name="SecurityValue" text="—" style="font-size: 15px; color: white; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 100%;">
                    <ui:Label text="THREAT LEVEL" style="font-size: 11px; color: #546e7a;" />
                    <ui:Label name="ThreatValue" text="—" style="font-size: 14px; color: rgb(255,82,82); -unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- MILITARY SNAPSHOT -->
            <ui:Label text="◈ MILITARY READINESS" style="font-size: 12px; color: rgb(0,210,255); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 8px;" />
            <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 14px; background-color: rgba(0,0,0,0.25); padding: 10px; border-radius: 4px;">
                <ui:VisualElement style="width: 48%; margin-bottom: 8px;">
                    <ui:Label text="ARMY PERSONNEL" style="font-size: 11px; color: #546e7a;" />
                    <ui:Label name="MilPersonnel" text="—" style="font-size: 14px; color: white;" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 48%; margin-bottom: 8px;">
                    <ui:Label text="MILITARY STRENGTH" style="font-size: 11px; color: #546e7a;" />
                    <ui:Label name="MilStrength" text="—" style="font-size: 14px; color: white;" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 48%; margin-bottom: 8px;">
                    <ui:Label text="TANKS" style="font-size: 11px; color: #546e7a;" />
                    <ui:Label name="MilTanks" text="—" style="font-size: 14px; color: white;" />
                </ui:VisualElement>
                <ui:VisualElement style="width: 48%; margin-bottom: 8px;">
                    <ui:Label text="FIGHTER JETS" style="font-size: 11px; color: #546e7a;" />
                    <ui:Label name="MilJets" text="—" style="font-size: 14px; color: white;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ACTIVE CRISES -->
            <ui:Label name="CrisisHeader" text="◈ ACTIVE REGIONAL CRISES" style="font-size: 12px; color: rgb(255,82,82); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 8px;" />
            <ui:VisualElement name="CrisisContainer" style="margin-bottom: 14px;" />

            <!-- ACTION BUTTONS -->
            <ui:Label text="◈ DIPLOMATIC OPERATIONS" style="font-size: 12px; color: rgb(0,210,255); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 8px;" />
            <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; margin-bottom: 8px;">
                <ui:Button name="BtnTrade" text="TRADE DEAL" class="button-premium" style="flex-grow: 1; margin: 2px; height: 30px; font-size: 12px;" />
                <ui:Button name="BtnAlly" text="PROPOSE ALLIANCE" class="button-premium" style="flex-grow: 1; margin: 2px; height: 30px; font-size: 12px; background-color: rgba(76,175,80,0.2);" />
            </ui:VisualElement>

            <ui:Label text="◈ INTELLIGENCE OPERATIONS" style="font-size: 12px; color: rgb(0,210,255); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 8px;" />
            <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; margin-bottom: 8px;">
                <ui:Button name="BtnSpy" text="INFILTRATE" class="button-premium" style="flex-grow: 1; margin: 2px; height: 30px; font-size: 12px; border-color: #ffc107;" />
                <ui:Button name="BtnSabotage" text="SABOTAGE INFRA" class="button-premium" style="flex-grow: 1; margin: 2px; height: 30px; font-size: 12px; border-color: #ff1744;" />
            </ui:VisualElement>

            <ui:Label text="◈ MILITARY DIRECTIVE" style="font-size: 12px; color: rgb(0,210,255); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 8px;" />
            <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; margin-bottom: 20px;">
                <ui:Button name="BtnReinforce" text="SEND AID" class="button-premium" style="flex-grow: 1; margin: 2px; height: 30px; font-size: 12px;" />
                <ui:Button name="BtnWar" text="DECLARE WAR" class="button-premium" style="flex-grow: 1; margin: 2px; height: 30px; font-size: 12px; background-color: rgba(255,23,68,0.2); border-color: #ff1744;" />
            </ui:VisualElement>

        </ui:ScrollView>

        <ui:Button name="ClosePanel" text="CLOSE DOSSIER ×" class="button-premium" style="margin-top: 10px; height: 35px; font-size: 13px; background-color: rgba(255,255,255,0.02);" />
    </ui:VisualElement>
</ui:UXML>
