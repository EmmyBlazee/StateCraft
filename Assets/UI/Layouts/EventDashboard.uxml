<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    <ui:VisualElement name="EventDashboard" class="standard-dashboard hologram-border" style="display: none;">

        <!-- HEADER -->
        <ui:VisualElement name="Header" class="econ-topbar">
            <ui:VisualElement class="econ-country-block">
                <ui:VisualElement>
                    <ui:VisualElement class="econ-country-line">
                        <ui:Label text="SITUATION ROOM" class="econ-country-name" style="color: rgb(255, 82, 82);" />
                        <ui:VisualElement class="econ-flag" />
                    </ui:VisualElement>
                    <ui:Label text="ACTION REQUIRED" class="econ-country-subtitle" style="color: rgb(255, 152, 0);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="econ-kpi-strip">
                <ui:VisualElement class="econ-kpi"><ui:Label text="ACTIVE EVENTS" class="econ-kpi-label" /><ui:Label name="KpiActiveEvents" text="12" class="econ-kpi-value" /><ui:Label text="Total" class="econ-kpi-delta" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="CRITICAL" class="econ-kpi-label" style="color: rgb(255, 82, 82);" /><ui:Label name="KpiCritical" text="2" class="econ-kpi-value" /><ui:Label text="Immediate" class="econ-kpi-delta negative" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="HIGH" class="econ-kpi-label" style="color: rgb(255, 152, 0);" /><ui:Label name="KpiHigh" text="4" class="econ-kpi-value" /><ui:Label text="Urgent" class="econ-kpi-delta warning" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="MEDIUM" class="econ-kpi-label" style="color: rgb(241, 196, 15);" /><ui:Label name="KpiMedium" text="6" class="econ-kpi-value" /><ui:Label text="Pending" class="econ-kpi-delta" /></ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="econ-date-box">
                <ui:Label name="DateMain" text="08 JAN 2026" class="econ-date-main" />
                <ui:Label name="DateSub" text="Thursday, 09:12" class="econ-date-sub" />
            </ui:VisualElement>
            <ui:Button name="BtnCloseEventDashboard" text="×" class="econ-icon-button" />
        </ui:VisualElement>

        <!-- CONTENT -->
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            
            <!-- CURRENT EVENTS (Actionable) -->
            <ui:VisualElement style="flex-grow: 1; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                <ui:Label text="CURRENT EVENTS" style="font-size: 16px; color: white; -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                <ui:ScrollView name="ActiveEventsScroll" style="flex-grow: 1;">
                    <ui:VisualElement name="ActiveEventsList" style="flex-direction: column;" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- UPCOMING EVENTS (Calendar) -->
            <ui:VisualElement style="width: 250px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                <ui:Label text="UPCOMING" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                <ui:ScrollView name="UpcomingEventsScroll" style="flex-grow: 1;">
                    <ui:VisualElement name="UpcomingEventsList" style="flex-direction: column;" />
                </ui:ScrollView>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
