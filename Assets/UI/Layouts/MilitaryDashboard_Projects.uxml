<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
            <ui:VisualElement name="PanelProjects" style="display: none; height: 100%;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; height: 100%; padding: 8px;">
                    <ui:VisualElement style="width: 45%; height: 100%;">
                        <ui:Label text="ACTIVE STRATEGIC PROJECTS" style="font-size: 14px; color: rgb(25, 127, 229); -unity-font-style: bold; margin-bottom: 8px;" />
                        <ui:ScrollView name="ActiveProjectsList" mode="Vertical" show-horizontal-scroller="False" style="flex-grow: 1;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="width: 53%; height: 100%;">
                        <ui:Label text="STRATEGIC RESEARCH &amp; PROCUREMENT DIRECTIVES" style="font-size: 14px; color: rgb(25, 127, 229); -unity-font-style: bold; margin-bottom: 8px;" />
                        <ui:ScrollView name="AvailableProjectsList" mode="Vertical" show-horizontal-scroller="False" style="flex-grow: 1;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
</ui:UXML>
