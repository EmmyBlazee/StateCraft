                            <ui:VisualElement name="SideProject_Info" class="projects-info-list"><ui:Label text="Category                         Infrastructure" /><ui:Label text="Location                         Lagos State" /><ui:Label text="Started On                       01 SEP 2025" /><ui:Label text="Expected Completion              MAY 2026" /></ui:VisualElement>
                            <ui:Label text="DETAILED BENEFITS" class="projects-side-heading market" />
                            <ui:VisualElement name="SideProject_Benefits" class="projects-info-list"><ui:Label text="Trade Revenue                    +₦180B / month" class="positive" /><ui:Label text="GDP Growth                       +0.8%" class="positive" /><ui:Label text="Jobs Created                     +20,000" class="positive" /><ui:Label text="Foreign Investment               +₦250B" class="positive" /><ui:Label text="Logistics Efficiency             +25%" class="positive" /></ui:VisualElement>
                            <ui:Label text="PROJECT RISKS                                      Low" class="negative" />
                            <ui:VisualElement class="projects-info-list"><ui:Label text="Cost Overrun Risk                12%" /><ui:Label text="Delay Risk                        8%" /><ui:Label text="Environmental Risk                5%" /></ui:VisualElement>
                            <ui:Button text="VIEW FULL REPORT" class="project-report-btn" style="display: none;" />
                        </ui:VisualElement>

                        <ui:VisualElement name="ProjectsAdviserCard" class="projects-side-card adviser" style="display: none;">
                            <ui:Label text="PROJECTS ADVISER" class="projects-title" />
                            <ui:VisualElement class="projects-adviser-main"><ui:VisualElement class="projects-adviser-portrait"><ui:Label text="EA" /></ui:VisualElement><ui:VisualElement class="adviser-copy-container"><ui:Label text="Dr. Adekunle Okafor" class="project-card-title" /><ui:Label text="Chief Economic Adviser" class="projects-copy" /><ui:Label text="RECOMMENDATION" class="market" /><ui:Label name="ProjectsAdviserBody" text="Focus on Infrastructure and Energy projects to drive economic growth and improve national stability." class="projects-copy" /></ui:VisualElement></ui:VisualElement>
                            <ui:Button text="VIEW ADVISER NOTES" class="project-report-btn" style="display: none;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Button name="BtnOpenBuildMenu" text="BLUEPRINTS" style="display: none;" />
                    <ui:VisualElement name="ConstructionSummary" style="display: none;" />
                    <ui:VisualElement name="ConstructionCardsContainer" style="display: none;" />
                    <ui:Label name="BlueprintSectionTitle" text="BLUEPRINT CATALOG" style="display: none;" />
                    <ui:VisualElement name="BlueprintCatalog" style="display: none;" />
                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement name="EconomyActionModal" class="economy-modal-overlay" style="display: none;">
                <ui:VisualElement class="economy-modal-card">
                    <ui:VisualElement class="economy-modal-header">
                        <ui:Label name="EconomyModalTitle" text="Confirm Action" class="economy-modal-title" />
                        <ui:Button name="EconomyModalClose" text="×" class="economy-modal-close" />
                    </ui:VisualElement>
                    <ui:Label name="EconomyModalBody" text="Review this action before continuing." class="economy-modal-body" />
                    <ui:VisualElement name="EconomyModalImpact" class="economy-modal-impact" />
                    <ui:VisualElement class="economy-modal-actions">
                        <ui:Button name="EconomyModalCancel" text="CANCEL" class="economy-modal-secondary" />
                        <ui:Button name="EconomyModalConfirm" text="CONFIRM" class="economy-modal-primary" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>


