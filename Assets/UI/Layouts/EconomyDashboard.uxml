<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    <ui:VisualElement name="EconomyDashboard" class="economy-command standard-dashboard" style="display: none;">
        <ui:VisualElement name="Header" class="econ-topbar">
            <ui:VisualElement class="econ-country-block">
                <ui:VisualElement>
                    <ui:VisualElement class="econ-country-line">
                        <ui:Label name="CountryHeaderName" text="NIGERIA" class="econ-country-name" />
                        <ui:VisualElement name="CountryHeaderFlag" class="econ-flag" />
                    </ui:VisualElement>
                    <ui:Label name="CreditRatingBadge" text="B+ (STABLE)" class="econ-country-subtitle" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="econ-kpi-strip">
                <ui:VisualElement class="econ-kpi"><ui:Label text="TREASURY" class="econ-kpi-label" /><ui:Label name="ValTreasury" text="—" class="econ-kpi-value" /><ui:Label name="HeaderIncomeLabel" text="+₦0B" class="econ-kpi-delta positive" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="GDP" class="econ-kpi-label" /><ui:Label name="ValGDP" text="—" class="econ-kpi-value" /><ui:Label name="ValGDPGrowth" text="—" class="econ-kpi-delta positive" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="INFLATION" class="econ-kpi-label" /><ui:Label name="ValInflation" text="—" class="econ-kpi-value" /><ui:Label name="ValInflationDelta" text="+0.7% MoM" class="econ-kpi-delta negative" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="NATIONAL DEBT" class="econ-kpi-label" /><ui:Label name="ValTotalDebt" text="—" class="econ-kpi-value" /><ui:Label name="ValDebtRatio" text="Debt / GDP" class="econ-kpi-delta warning" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="FX RATE" class="econ-kpi-label" /><ui:Label name="ValExchange" text="—" class="econ-kpi-value" /><ui:Label name="HeaderExpenseLabel" text="-₦0B" class="econ-kpi-delta negative" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="APPROVAL" class="econ-kpi-label" /><ui:Label name="ValApproval" text="65%" class="econ-kpi-value" /><ui:Label name="ValApprovalDelta" text="+2% MoM" class="econ-kpi-delta positive" /></ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="econ-date-box">
                <ui:Label name="DateMain" text="08 JAN 2026" class="econ-date-main" />
                <ui:Label name="DateSub" text="Thursday, 09:12" class="econ-date-sub" />
            </ui:VisualElement>
            <ui:Button name="CloseEconomy" text="×" class="econ-icon-button" />
        </ui:VisualElement>

        <ui:VisualElement name="SubTabs" class="econ-tabs">
            <ui:Button name="TabDashboard" text="⌂  OVERVIEW" class="econ-tab active-tab" />
            <ui:Button name="TabProduction" text="▣  TAXATION" class="econ-tab" />
            <ui:Button name="TabIndustry" text="▦  INDUSTRIES" class="econ-tab" />
            <ui:Button name="TabInfrastructure" text="▤  BUDGET" class="econ-tab" />
            <ui:Button name="TabConstruction" text="⌁  PROJECTS" class="econ-tab" />
        </ui:VisualElement>

        <ui:VisualElement name="PanelContainer" class="economy-tab-panel">
            <ui:ScrollView name="PanelDashboard" class="econ-overview-scroll">
                <ui:VisualElement class="econ-overview">
                    <ui:VisualElement class="econ-left-column">
                        <ui:VisualElement class="econ-panel">
                            <ui:VisualElement class="econ-panel-header"><ui:Label text="GOVERNMENT REVENUE" class="econ-panel-title" /><ui:Label text="This Month⌄" class="econ-muted" /></ui:VisualElement>
                            <ui:VisualElement name="IncomeList" class="econ-ledger-list" />
                            <ui:VisualElement class="econ-total-row"><ui:Label text="TOTAL REVENUE" class="positive" /><ui:Label name="HeaderIncomeMirror" text="+4.1%" class="positive" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="econ-panel">
                            <ui:VisualElement class="econ-panel-header"><ui:Label text="GOVERNMENT EXPENDITURE" class="econ-panel-title" /><ui:Label text="This Month⌄" class="econ-muted" /></ui:VisualElement>
                            <ui:VisualElement name="ExpenseList" class="econ-ledger-list" />
                            <ui:VisualElement class="econ-total-row"><ui:Label text="TOTAL EXPENDITURE" class="negative" /><ui:Label name="HeaderExpenseMirror" text="+3.2%" class="negative" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="econ-balance-card">
                            <ui:Label text="BUDGET BALANCE" class="econ-panel-title negative" />
                            <ui:Label name="ValBudgetBalance" text="—" class="econ-balance-value" />
                            <ui:VisualElement class="metric-row"><ui:Label text="NET" class="metric-label" /><ui:Label name="ValNetBalance" text="—" class="metric-value-large" /></ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="econ-center-column">
                        <ui:VisualElement name="EconReportsPanel" class="econ-panel econ-reports">
                            <ui:VisualElement class="econ-panel-header"><ui:Label text="ECONOMIC REPORTS" class="econ-panel-title" /></ui:VisualElement>
                            <ui:VisualElement class="econ-report alert"><ui:Label text="▴" class="econ-report-icon" /><ui:VisualElement class="econ-report-body"><ui:Label text="ECONOMIC ALERT" class="negative" /><ui:Label text="Inflation Continues to Rise" class="econ-report-title" /><ui:Label text="Food prices and energy costs are driving inflation higher across the country." class="econ-report-copy" /><ui:Label text="IMPACT: - Stability    - Approval Rating" class="negative" /></ui:VisualElement><ui:Label text="Today, 08:45" class="econ-muted" /></ui:VisualElement>
                            <ui:VisualElement class="econ-report good"><ui:Label text="↗" class="econ-report-icon" /><ui:VisualElement class="econ-report-body"><ui:Label text="POSITIVE DEVELOPMENT" class="positive" /><ui:Label text="Oil Exports Increase" class="econ-report-title" /><ui:Label text="Global demand has increased our crude oil exports this month." class="econ-report-copy" /><ui:Label text="IMPACT: + Treasury    + GDP Growth" class="positive" /></ui:VisualElement><ui:Label text="Today, 06:30" class="econ-muted" /></ui:VisualElement>
                            <ui:VisualElement class="econ-report warning"><ui:Label text="₦" class="econ-report-icon" /><ui:VisualElement class="econ-report-body"><ui:Label text="POLICY UPDATE" class="warning" /><ui:Label text="New Tax Reform Policy Enacted" class="econ-report-title" /><ui:Label text="Tax reforms are expected to improve revenue collection over the next quarter." class="econ-report-copy" /><ui:Label text="IMPACT: + Revenue    - Short Term Approval" class="warning" /></ui:VisualElement><ui:Label text="Yesterday, 22:10" class="econ-muted" /></ui:VisualElement>
                            <ui:VisualElement class="econ-report market"><ui:Label text="◎" class="econ-report-icon" /><ui:VisualElement class="econ-report-body"><ui:Label text="GLOBAL MARKET UPDATE" class="market" /><ui:Label text="Oil Prices Increase" class="econ-report-title" /><ui:Label text="Brent crude price increased due to tensions in the Middle East." class="econ-report-copy" /><ui:Label text="IMPACT: + Revenue    + Trade Balance" class="positive" /></ui:VisualElement><ui:Label text="Yesterday, 19:40" class="econ-muted" /></ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="econ-sector-panel">
                            <ui:VisualElement class="econ-panel-header"><ui:Label text="ECONOMIC SECTORS" class="econ-panel-title" /><ui:Label name="BtnViewAllSectors" text="VIEW ALL SECTORS ›" class="market" /></ui:VisualElement>
                            <ui:VisualElement name="EconSectorsGrid" class="econ-sector-grid">
                                <ui:VisualElement class="econ-sector-card"><ui:Label text="🛢  OIL &amp; GAS" class="econ-sector-title" /><ui:Label text="Contribution 34%" /><ui:Label text="Growth (YoY) +5.2%" class="positive" /><ui:Label text="Employment 2.4M" class="econ-muted" /></ui:VisualElement>
                                <ui:VisualElement class="econ-sector-card"><ui:Label text="🌿  AGRICULTURE" class="econ-sector-title" /><ui:Label text="Contribution 18%" /><ui:Label text="Growth (YoY) +2.1%" class="positive" /><ui:Label text="Employment 7.8M" class="econ-muted" /></ui:VisualElement>
                                <ui:VisualElement class="econ-sector-card"><ui:Label text="▰  MANUFACTURING" class="econ-sector-title" /><ui:Label text="Contribution 12%" /><ui:Label text="Growth (YoY) +1.8%" class="positive" /><ui:Label text="Employment 1.9M" class="econ-muted" /></ui:VisualElement>
                                <ui:VisualElement class="econ-sector-card"><ui:Label text="♟  SERVICES" class="econ-sector-title" /><ui:Label text="Contribution 28%" /><ui:Label text="Growth (YoY) +3.4%" class="positive" /><ui:Label text="Employment 9.1M" class="econ-muted" /></ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="econ-right-column">
                    <ui:VisualElement class="econ-panel econ-adviser">
                        <ui:Label text="CHIEF ECONOMIC ADVISER" class="econ-panel-title" />
                        <ui:VisualElement class="econ-adviser-main">
                            <ui:VisualElement class="econ-adviser-portrait"><ui:Label text="EA" class="econ-adviser-initials" /></ui:VisualElement>
                            <ui:VisualElement class="econ-adviser-copy">
                                <ui:Label name="OverviewAdviserName" text="Dr. Adekunle Okafor" class="econ-report-title" />
                                <ui:Label text="Chief Economic Adviser" class="econ-muted" />
                                <ui:Label text="RECOMMENDATION" class="positive" />
                                <ui:Label name="OverviewAdviserTitle" text="Reduce Fuel Subsidy" class="econ-report-title" />
                                <ui:Label name="OverviewAdviserBody" text="Gradually reduce fuel subsidy over 3 months to ease fiscal pressure." class="econ-report-copy" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="OverviewAdviserImpactGrid" class="econ-impact-grid">
                            <ui:VisualElement>
                                <ui:Label text="BENEFITS" class="positive" />
                                <ui:Label name="OverviewAdviserBenefit1" text="+ Treasury" class="positive" />
                                <ui:Label name="OverviewAdviserBenefit2" text="+ Fiscal Balance" class="positive" />
                                <ui:Label name="OverviewAdviserBenefit3" text="+ Investor Confidence" class="positive" />
                            </ui:VisualElement>
                            <ui:VisualElement>
                                <ui:Label text="RISKS" class="negative" />
                                <ui:Label name="OverviewAdviserRisk1" text="- Approval Rating" class="negative" />
                                <ui:Label name="OverviewAdviserRisk2" text="+ Inflation" class="negative" />
                                <ui:Label name="OverviewAdviserRisk3" text="- Public Unrest Risk" class="negative" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="econ-controls">
                            <ui:VisualElement><ui:VisualElement class="metric-row"><ui:Label text="TAX RATE" class="metric-label" /><ui:Label name="OverviewLabelTaxRate" text="15%" class="metric-value" /></ui:VisualElement><ui:Slider name="OverviewSliderTaxRate" low-value="0" high-value="50" value="15" /></ui:VisualElement>
                            <ui:VisualElement><ui:VisualElement class="metric-row"><ui:Label text="SUBSIDIES" class="metric-label" /><ui:Label name="LabelSubsidyLevel" text="5%" class="metric-value" /></ui:VisualElement><ui:Slider name="SliderSubsidyLevel" low-value="0" high-value="30" value="5" /></ui:VisualElement>
                            <ui:VisualElement><ui:VisualElement class="metric-row"><ui:Label text="INTEREST RATE" class="metric-label" /><ui:Label name="LabelInterestRate" text="5%" class="metric-value" /></ui:VisualElement><ui:Slider name="SliderInterestRate" low-value="0" high-value="20" value="5" /></ui:VisualElement>
                            <ui:VisualElement><ui:VisualElement class="metric-row"><ui:Label text="IMPORT TARIFFS" class="metric-label" /><ui:Label name="OverviewLabelTariffRate" text="10%" class="metric-value" /></ui:VisualElement><ui:Slider name="OverviewSliderTariffRate" low-value="0" high-value="50" value="10" /></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="OverviewAdviserActionRow" class="econ-action-row">
                            <ui:Button name="OverviewApprovePolicy" text="✓  APPROVE POLICY" class="econ-approve-button" />
                            <ui:Button name="OverviewDeclinePolicy" text="✕  DECLINE" class="econ-decline-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="econ-panel econ-debt-panel">
                        <ui:Label text="DEBT &amp; FINANCING" class="econ-panel-title" />
                        <ui:VisualElement class="metric-row"><ui:Label text="Domestic" class="metric-label" /><ui:Label name="ValDomesticDebt" text="—" class="metric-value" /></ui:VisualElement>
                        <ui:VisualElement class="metric-row"><ui:Label text="Foreign" class="metric-label" /><ui:Label name="ValForeignDebt" text="—" class="metric-value" /></ui:VisualElement>
                        <ui:ProgressBar name="DebtRatioBar" value="0" high-value="100" class="econ-progress" />
                        <ui:VisualElement class="metric-row"><ui:Label text="DEBT SERVICE" class="metric-label" /><ui:Label name="LabelDebtService" text="100%" class="metric-value" /></ui:VisualElement>
                        <ui:Slider name="SliderDebtService" low-value="0" high-value="200" value="100" />
                        <ui:Label name="LblDebtServiceCost" text="Monthly payment: —" class="econ-muted" />
                        <ui:VisualElement class="econ-action-row"><ui:Button name="BtnBorrowDebt" text="BORROW ₦50B" class="econ-small-button" /><ui:Button name="BtnRepayDebt" text="REPAY ₦50B" class="econ-small-button" /></ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="OverviewProjectsPanel" class="econ-panel econ-projects">
                        <ui:VisualElement class="econ-panel-header"><ui:Label text="MAJOR ECONOMIC PROJECTS" class="econ-panel-title" /><ui:Label name="BtnViewAllProjects" text="VIEW ALL PROJECTS ›" class="market" /></ui:VisualElement>
                        <ui:VisualElement class="econ-project-row"><ui:VisualElement class="econ-project-thumb" /><ui:VisualElement class="econ-project-info"><ui:Label text="Lagos Deep Sea Port" class="econ-report-title" /><ui:Label text="Infrastructure" class="econ-muted" /><ui:ProgressBar value="72" high-value="100" class="econ-progress" /></ui:VisualElement><ui:Label text="₦850B&#10;Dec 2026" /></ui:VisualElement>
                        <ui:VisualElement class="econ-project-row"><ui:VisualElement class="econ-project-thumb rail" /><ui:VisualElement class="econ-project-info"><ui:Label text="National Rail Upgrade" class="econ-report-title" /><ui:Label text="Infrastructure" class="econ-muted" /><ui:ProgressBar value="34" high-value="100" class="econ-progress warning-bar" /></ui:VisualElement><ui:Label text="₦620B&#10;Aug 2027" /></ui:VisualElement>
                        <ui:VisualElement class="econ-project-row"><ui:VisualElement class="econ-project-thumb tech" /><ui:VisualElement class="econ-project-info"><ui:Label text="Nigeria Satellite Program" class="econ-report-title" /><ui:Label text="Technology" class="econ-muted" /><ui:ProgressBar value="12" high-value="100" class="econ-progress market-bar" /></ui:VisualElement><ui:Label text="₦120B&#10;Jun 2028" /></ui:VisualElement>
                    </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="StatusIndicators" style="display: none;" />
                <ui:Label name="EconomyBriefing" text="—" style="display: none;" />
                <ui:ScrollView name="EconomyLiveFeed" style="display: none;" />
            </ui:ScrollView>

            <ui:ScrollView name="PanelProduction" class="tax-scroll economy-tab-panel" style="display: none;">
                <ui:VisualElement class="tax-dashboard">
                    <ui:VisualElement class="tax-header-card">
                        <ui:Label text="▥" class="tax-header-icon" />
                        <ui:VisualElement>
                            <ui:Label text="TAXATION POLICY" class="tax-title" />
                            <ui:Label text="Adjust tax rates to balance revenue generation and economic growth." class="tax-subtitle" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="tax-grid">
                        <ui:VisualElement class="tax-left">
                            <ui:VisualElement class="tax-panel">
                                <ui:Label text="TAX CATEGORIES" class="tax-panel-title" />

                                <ui:VisualElement class="tax-category-row good">
                                    <ui:Label text="●" class="tax-category-icon" />
                                    <ui:VisualElement class="tax-category-info"><ui:Label text="INCOME TAX" class="tax-row-title" /><ui:Label text="Tax on individuals' income" class="tax-row-copy" /><ui:Label text="Base: 12%" class="positive" /></ui:VisualElement>
                                    <ui:VisualElement class="tax-rate-cell"><ui:Button text="−" class="tax-step-btn" /><ui:Label text="CURRENT RATE" class="tax-mini-label" /><ui:Label name="TaxIncome_Rate" text="12%" class="tax-rate-value" /><ui:ProgressBar name="TaxIncome_Bar" value="48" high-value="100" class="tax-rate-bar" /></ui:VisualElement>
                                    <ui:Button text="+" class="tax-step-btn" />
                                    <ui:VisualElement class="tax-revenue-cell"><ui:Label text="EST. MONTHLY REVENUE" class="tax-mini-label" /><ui:Label name="TaxIncome_Revenue" text="₦120B" class="tax-revenue-value" /><ui:Label text="18.2% of Total Revenue" class="tax-row-copy" /></ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="tax-category-row good selected">
                                    <ui:Label text="▥" class="tax-category-icon" />
                                    <ui:VisualElement class="tax-category-info"><ui:Label text="CORPORATE TAX" class="tax-row-title" /><ui:Label text="Tax on company profits" class="tax-row-copy" /><ui:Label text="Base: 18%" class="positive" /></ui:VisualElement>
                                    <ui:VisualElement class="tax-rate-cell"><ui:Button text="−" class="tax-step-btn" /><ui:Label text="CURRENT RATE" class="tax-mini-label" /><ui:Label name="LabelTaxRate" text="18%" class="tax-rate-value" /><ui:Slider name="SliderTaxRate" low-value="0" high-value="50" value="18" class="tax-slider" /></ui:VisualElement>
                                    <ui:Button text="+" class="tax-step-btn" />
                                    <ui:VisualElement class="tax-revenue-cell"><ui:Label text="EST. MONTHLY REVENUE" class="tax-mini-label" /><ui:Label name="TaxCorporate_Revenue" text="₦85B" class="tax-revenue-value" /><ui:Label text="12.8% of Total Revenue" class="tax-row-copy" /></ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="tax-category-row good">
                                    <ui:Label text="▣" class="tax-category-icon" />
                                    <ui:VisualElement class="tax-category-info"><ui:Label text="VALUE ADDED TAX (VAT)" class="tax-row-title" /><ui:Label text="Tax on goods and services" class="tax-row-copy" /><ui:Label text="Base: 7.5%" class="positive" /></ui:VisualElement>
                                    <ui:VisualElement class="tax-rate-cell"><ui:Button text="−" class="tax-step-btn" /><ui:Label text="CURRENT RATE" class="tax-mini-label" /><ui:Label name="TaxVAT_Rate" text="7.5%" class="tax-rate-value" /><ui:ProgressBar name="TaxVAT_Bar" value="30" high-value="100" class="tax-rate-bar" /></ui:VisualElement>
                                    <ui:Button text="+" class="tax-step-btn" />
                                    <ui:VisualElement class="tax-revenue-cell"><ui:Label text="EST. MONTHLY REVENUE" class="tax-mini-label" /><ui:Label name="TaxVAT_Revenue" text="₦95B" class="tax-revenue-value" /><ui:Label text="14.4% of Total Revenue" class="tax-row-copy" /></ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="tax-category-row warning">
                                    <ui:Label text="⚓" class="tax-category-icon" />
                                    <ui:VisualElement class="tax-category-info"><ui:Label text="IMPORT DUTY" class="tax-row-title" /><ui:Label text="Tax on imported goods" class="tax-row-copy" /><ui:Label text="Base: 5%" class="warning" /></ui:VisualElement>
                                    <ui:VisualElement class="tax-rate-cell"><ui:Button text="−" class="tax-step-btn" /><ui:Label text="CURRENT RATE" class="tax-mini-label" /><ui:Label name="LabelTariffRate" text="5%" class="tax-rate-value" /><ui:Slider name="SliderTariffRate" low-value="0" high-value="50" value="5" class="tax-slider warning-slider" /></ui:VisualElement>
                                    <ui:Button text="+" class="tax-step-btn" />
                                    <ui:VisualElement class="tax-revenue-cell"><ui:Label text="EST. MONTHLY REVENUE" class="tax-mini-label" /><ui:Label name="TaxImport_Revenue" text="₦25B" class="tax-revenue-value warning" /><ui:Label text="3.8% of Total Revenue" class="tax-row-copy" /></ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="tax-category-row warning">
                                    <ui:Label text="↗" class="tax-category-icon" />
                                    <ui:VisualElement class="tax-category-info"><ui:Label text="EXPORT DUTY" class="tax-row-title" /><ui:Label text="Tax on exported goods" class="tax-row-copy" /><ui:Label text="Base: 2%" class="warning" /></ui:VisualElement>
                                    <ui:VisualElement class="tax-rate-cell"><ui:Button text="−" class="tax-step-btn" /><ui:Label text="CURRENT RATE" class="tax-mini-label" /><ui:Label name="TaxExport_Rate" text="2%" class="tax-rate-value" /><ui:ProgressBar name="TaxExport_Bar" value="16" high-value="100" class="tax-rate-bar warning-bar" /></ui:VisualElement>
                                    <ui:Button text="+" class="tax-step-btn" />
                                    <ui:VisualElement class="tax-revenue-cell"><ui:Label text="EST. MONTHLY REVENUE" class="tax-mini-label" /><ui:Label name="TaxExport_Revenue" text="₦15B" class="tax-revenue-value warning" /><ui:Label text="2.3% of Total Revenue" class="tax-row-copy" /></ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="tax-total-card">
                                    <ui:VisualElement><ui:Label text="TOTAL ESTIMATED MONTHLY REVENUE" class="positive" /><ui:Label name="TaxTotal_Revenue" text="₦340B" class="tax-total-value" /></ui:VisualElement>
                                    <ui:VisualElement><ui:Label text="% OF GDP" class="tax-mini-label" /><ui:Label name="TaxTotal_Ratio" text="10.2%" class="tax-total-meta" /></ui:VisualElement>
                                    <ui:VisualElement><ui:Label text="CHANGE FROM LAST MONTH" class="tax-mini-label" /><ui:Label name="TaxTotal_MoMDelta" text="+₦12.5B (+3.8%)" class="tax-total-meta positive" /></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Button text="↺  TAX REFORMS HISTORY" class="tax-history-btn" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="tax-middle">
                            <ui:VisualElement class="tax-panel">
                                <ui:Label text="TAX IMPACT SIMULATOR" class="tax-panel-title" />
                                <ui:VisualElement class="tax-sim-selected">
                                    <ui:Label name="SimSelectedTax" text="SELECTED TAX: CORPORATE TAX" class="positive" />
                                    <ui:VisualElement class="tax-sim-rate-row">
                                        <ui:VisualElement><ui:Label text="CURRENT RATE" class="tax-mini-label" /><ui:Label name="SimCurrentRate" text="18%" class="tax-rate-value" /></ui:VisualElement>
                                        <ui:Label text="→" class="tax-arrow" />
                                        <ui:VisualElement><ui:Label text="NEW RATE" class="tax-mini-label" /><ui:Label name="SimNewRate" text="20%" class="tax-rate-value positive" /></ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Label text="ESTIMATED IMPACT (Monthly)" class="tax-panel-title small" />
                                <ui:VisualElement class="tax-impact-list">
                                    <ui:VisualElement class="tax-impact-row"><ui:Label text="▰ Revenue" /><ui:Label name="SimRevenue" text="+₦15B" class="positive" /></ui:VisualElement>
                                    <ui:VisualElement class="tax-impact-row"><ui:Label text="▟ GDP Growth" /><ui:Label name="SimGDPImpact" text="-0.2%" class="negative" /></ui:VisualElement>
                                    <ui:VisualElement class="tax-impact-row"><ui:Label text="● Business Confidence" /><ui:Label text="-2.0%" class="negative" /></ui:VisualElement>
                                    <ui:VisualElement class="tax-impact-row"><ui:Label text="⌁ Investment Inflow" /><ui:Label text="-1.5%" class="negative" /></ui:VisualElement>
                                    <ui:VisualElement class="tax-impact-row"><ui:Label text="☷ Employment" /><ui:Label text="-5,200" class="negative" /></ui:VisualElement>
                                    <ui:VisualElement class="tax-impact-row"><ui:Label text="◆ Inflation" /><ui:Label text="+0.1%" class="negative" /></ui:VisualElement>
