<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />

    <ui:VisualElement name="WPanelProductionInner"
        style="display: flex; flex-grow: 1; flex-direction: column; padding: 8px; padding-top: 6px;">

        <!-- ─── KPI OVERVIEW STRIP ──────────────────────────── -->
        <ui:VisualElement
            style="flex-direction: row; align-items: stretch; margin-bottom: 8px; flex-shrink: 0;">
            
            <ui:VisualElement class="sub-panel" style="flex-direction: row; align-items: center; padding: 12px; margin-right: 8px; flex-grow: 1;">
                <ui:Label text="&#xf275;" class="fa-icon" style="font-size: 25px; color: rgb(120,120,120); margin-right: 12px;" />
                <ui:VisualElement style="flex-direction: column;">
                    <ui:Label name="WPrdActiveFactories" text="4" style="font-size: 21px; color: white; -unity-font-style: bold;" />
                    <ui:Label text="ACTIVE FACTORIES" style="font-size: 11px; color: rgb(35, 237, 86); letter-spacing: 1px;" />
                    <ui:Label name="WPrdTotalFactories" text="of 6 Total" style="font-size: 10px; color: rgb(100,100,100);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="sub-panel" style="flex-direction: row; align-items: center; padding: 12px; margin-right: 8px; flex-grow: 1;">
                <ui:Label text="&#xf013;" class="fa-icon" style="font-size: 25px; color: rgb(120,120,120); margin-right: 12px;" />
                <ui:VisualElement style="flex-direction: column; flex-grow: 1;">
                    <ui:Label name="WPrdUtilPct" text="76%" style="font-size: 21px; color: white; -unity-font-style: bold;" />
                    <ui:Label text="FACTORY UTILIZATION" style="font-size: 11px; color: rgb(180,180,180); letter-spacing: 1px;" />
                    <ui:Label text="Across all facilities" style="font-size: 10px; color: rgb(35, 237, 86);" />
                    <ui:ProgressBar name="WPrdUtilBar" value="76" style="height: 4px; margin-top: 4px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="sub-panel" style="flex-direction: row; align-items: center; padding: 12px; margin-right: 8px; flex-grow: 1;">
                <ui:Label text="&#xf155;" class="fa-icon" style="font-size: 25px; color: rgb(120,120,120); margin-right: 12px;" />
                <ui:VisualElement style="flex-direction: column;">
                    <ui:Label name="WPrdMonthlyCost" text="₦15.8B" style="font-size: 21px; color: white; -unity-font-style: bold;" />
                    <ui:Label text="MONTHLY PROD. COST" style="font-size: 11px; color: rgb(180,180,180); letter-spacing: 1px;" />
                    <ui:Label text="Operating expenses" style="font-size: 10px; color: rgb(100,100,100);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="sub-panel" style="flex-direction: row; align-items: center; padding: 12px; margin-right: 8px; flex-grow: 1;">
                <ui:Label text="&#xf1b2;" class="fa-icon" style="font-size: 25px; color: rgb(120,120,120); margin-right: 12px;" />
                <ui:VisualElement style="flex-direction: column;">
                    <ui:Label name="WPrdMonthlyOutput" text="₦28.4B" style="font-size: 21px; color: white; -unity-font-style: bold;" />
                    <ui:Label text="MONTHLY OUTPUT VALUE" style="font-size: 11px; color: rgb(180,180,180); letter-spacing: 1px;" />
                    <ui:Label text="Total production value" style="font-size: 10px; color: rgb(100,100,100);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="sub-panel" style="flex-direction: row; align-items: center; padding: 12px; flex-grow: 1;">
                <ui:Label text="&#xf017;" class="fa-icon" style="font-size: 25px; color: rgb(120,120,120); margin-right: 12px;" />
                <ui:VisualElement style="flex-direction: column;">
                    <ui:Label name="WPrdAvgCompletion" text="2.7" style="font-size: 21px; color: white; -unity-font-style: bold;" />
                    <ui:Label text="AVG. COMPLETION TIME" style="font-size: 11px; color: rgb(180,180,180); letter-spacing: 1px;" />
                    <ui:Label text="Months" style="font-size: 10px; color: rgb(100,100,100);" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ─── MAIN BODY ──────────────────────────── -->
        <ui:VisualElement style="flex-direction: row; flex-grow: 1; min-height: 0;">

            <!-- LEFT: ACTIVE PRODUCTION GRID -->
            <ui:VisualElement style="flex-grow: 1; flex-direction: column; min-width: 0; margin-right: 8px;">
                <ui:Label text="ACTIVE PRODUCTION" style="font-size: 12px; color: rgb(35, 237, 86); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 8px; flex-shrink: 0;" />

                <ui:ScrollView name="WPrdActiveList" mode="Vertical" show-horizontal-scroller="False" style="flex-grow: 1;">
                    <!-- Controller will populate the grid with cards here -->
                    <ui:VisualElement name="WPrdActiveGrid" style="flex-direction: row; flex-wrap: wrap; justify-content: flex-start; align-content: flex-start;" />
                </ui:ScrollView>

                <!-- RECENTLY COMPLETED -->
                <ui:Label text="RECENTLY COMPLETED" style="font-size: 12px; color: rgb(35, 237, 86); -unity-font-style: bold; letter-spacing: 1px; margin-top: 8px; margin-bottom: 8px; flex-shrink: 0;" />
                <ui:ScrollView mode="Horizontal" style="flex-shrink: 0; height: 80px;">
                    <ui:VisualElement name="WPrdRecentList" style="flex-direction: row;" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- RIGHT: NEW ORDER FORM & FACILITIES -->
            <ui:VisualElement style="width: 320px; flex-shrink: 0; flex-direction: column;">

                <!-- NEW PRODUCTION ORDER -->
                <ui:VisualElement class="sub-panel" style="padding: 12px; margin-bottom: 8px; flex-direction: column;">
                    <ui:Label text="NEW PRODUCTION ORDER" style="font-size: 12px; color: rgb(35, 237, 86); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 12px;" />
                    
                    <ui:ScrollView name="WPrdQuickOrderList" style="flex-grow: 1; max-height: 250px;">
                        <!-- Controller will populate quick orders here -->
                    </ui:ScrollView>

                    <ui:Button name="WPrdBtnViewQueue" text="VIEW PRODUCTION QUEUE" class="button-premium" style="height: 24px; font-size: 11px; margin-top: 8px;" />
                </ui:VisualElement>

                <!-- PRODUCTION FACILITIES -->
                <ui:VisualElement class="sub-panel" style="padding: 12px; flex-grow: 1; flex-direction: column;">
                    <ui:Label text="PRODUCTION FACILITIES" style="font-size: 12px; color: rgb(35, 237, 86); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 12px;" />
                    
                    <ui:ScrollView name="WPrdFacilityList" style="flex-grow: 1;">
                        <!-- Controller will populate facilities here -->
                    </ui:ScrollView>
                    
                    <ui:Button name="WPrdBtnManageFacilities" text="MANAGE FACILITIES" class="button-premium" style="height: 24px; font-size: 11px; margin-top: 8px;" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
