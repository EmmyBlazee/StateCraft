<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    
    <ui:VisualElement name="PanelBases" style="display: none; height: 100%; flex-direction: column; padding: 12px; background-color: rgb(10, 14, 20);">
        
        <!-- HEADER ROW -->
        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 12px;">
            <ui:VisualElement style="width: 32px; height: 32px; border-radius: 4px; background-color: rgba(255,255,255,0.05); margin-right: 12px; justify-content: center; align-items: center; border-width: 1px; border-color: rgba(255,255,255,0.1);">
                <ui:Label text="&#xf1ad;" class="fa-icon" style="font-size: 18px; color: rgb(214, 223, 230);" />
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label text="BASES COMMAND" style="font-size: 16px; color: rgb(214, 223, 230); -unity-font-style: bold; letter-spacing: 1px;" />
                <ui:Label text="Build, manage and upgrade military bases across Nigeria and abroad." style="font-size: 13px; color: rgb(164, 176, 187);" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- FILTERS & TOP STATS -->
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <!-- Filters -->
            <ui:VisualElement style="flex-direction: row;">
                <ui:Button name="BtnFilterAll" class="nav-button active-tab" style="flex-direction: row; height: 32px; padding-left: 12px; padding-right: 12px;">
                    <ui:Label text="&#xf1ad;" class="fa-icon" style="font-size: 14px; margin-right: 6px; color: rgb(36, 238, 87);" />
                    <ui:Label text="ALL (12)" style="font-size: 13px; color: rgb(36, 238, 87); -unity-font-style: bold;" />
                </ui:Button>
                <ui:Button name="BtnFilterArmy" class="nav-button" style="flex-direction: row; height: 32px; padding-left: 12px; padding-right: 12px;">
                    <ui:Label text="&#xf807;" class="fa-icon" style="font-size: 14px; margin-right: 6px; color: rgb(164, 176, 187);" />
                    <ui:Label text="ARMY (6)" style="font-size: 13px;" />
                </ui:Button>
                <ui:Button name="BtnFilterAirForce" class="nav-button" style="flex-direction: row; height: 32px; padding-left: 12px; padding-right: 12px;">
                    <ui:Label text="&#xf0fb;" class="fa-icon" style="font-size: 14px; margin-right: 6px; color: rgb(164, 176, 187);" />
                    <ui:Label text="AIR FORCE (3)" style="font-size: 13px;" />
                </ui:Button>
                <ui:Button name="BtnFilterNavy" class="nav-button" style="flex-direction: row; height: 32px; padding-left: 12px; padding-right: 12px;">
                    <ui:Label text="&#xf13d;" class="fa-icon" style="font-size: 14px; margin-right: 6px; color: rgb(164, 176, 187);" />
                    <ui:Label text="NAVY (2)" style="font-size: 13px;" />
                </ui:Button>
                <ui:Button name="BtnFilterJoint" class="nav-button" style="flex-direction: row; height: 32px; padding-left: 12px; padding-right: 12px;">
                    <ui:Label text="&#xf005;" class="fa-icon" style="font-size: 14px; margin-right: 6px; color: rgb(164, 176, 187);" />
                    <ui:Label text="JOINT (1)" style="font-size: 13px;" />
                </ui:Button>
            </ui:VisualElement>

            <!-- Top Stats -->
            <ui:VisualElement style="flex-direction: row; height: 36px;">
                <ui:VisualElement style="flex-direction: column; justify-content: center; padding-left: 12px; padding-right: 12px; border-right-width: 1px; border-right-color: rgba(255,255,255,0.05); background-color: rgba(255,255,255,0.02);">
                    <ui:Label text="TOTAL BASES" style="font-size: 11px; color: rgb(164, 176, 187);" />
                    <ui:Label name="BasesStatTotal" text="12" style="font-size: 14px; color: white; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: column; justify-content: center; padding-left: 12px; padding-right: 12px; border-right-width: 1px; border-right-color: rgba(255,255,255,0.05); background-color: rgba(255,255,255,0.02);">
                    <ui:Label text="TOTAL CAPACITY" style="font-size: 11px; color: rgb(164, 176, 187);" />
                    <ui:Label name="BasesStatCapacity" text="38,000" style="font-size: 14px; color: white; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: column; justify-content: center; padding-left: 12px; padding-right: 12px; border-right-width: 1px; border-right-color: rgba(255,255,255,0.05); background-color: rgba(255,255,255,0.02);">
                    <ui:Label text="OCCUPIED CAPACITY" style="font-size: 11px; color: rgb(164, 176, 187);" />
                    <ui:VisualElement style="flex-direction: row; align-items: baseline;">
                        <ui:Label name="BasesStatOccupied" text="24,780" style="font-size: 14px; color: white; -unity-font-style: bold; margin-right: 4px;" />
                        <ui:Label text="(65%)" style="font-size: 12px; color: rgb(164, 176, 187);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: column; justify-content: center; padding-left: 12px; padding-right: 12px; background-color: rgba(255,255,255,0.02);">
                    <ui:Label text="MONTHLY UPKEEP" style="font-size: 11px; color: rgb(164, 176, 187);" />
                    <ui:Label name="BasesStatUpkeep" text="â‚¦12.4B" style="font-size: 14px; color: white; -unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 3-COLUMN MAIN AREA -->
        <ui:VisualElement style="flex-direction: row; flex-grow: 1; min-height: 0;">
            
            <!-- LEFT COLUMN: Base List -->
            <ui:VisualElement style="width: 28%; margin-right: 12px; flex-direction: column;">

                
                <ui:ScrollView name="BasesListContainer" style="flex-grow: 1; margin-bottom: 8px;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
                
                <ui:Button name="BtnConstructNewBase" text="+ CONSTRUCT NEW BASE" class="nav-button" style="height: 36px; font-size: 13px; border-width: 1px; border-color: rgba(255,255,255,0.1); border-radius: 4px;" />
            </ui:VisualElement>

            <!-- MIDDLE COLUMN: Base Details -->
            <ui:VisualElement name="BaseDetailsPanel" style="flex-grow: 1; flex-direction: column; margin-right: 12px;">
                <!-- Header -->
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; padding: 12px; background-color: rgba(255,255,255,0.02); border-radius: 4px; margin-bottom: 8px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                    <ui:Label name="DetailBaseName" text="LAGOS JOINT BASE" style="font-size: 16px; color: white; -unity-font-style: bold; letter-spacing: 1px;" />
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:VisualElement style="width: 6px; height: 6px; border-radius: 3px; background-color: rgb(36, 238, 87); margin-right: 6px;" />
                        <ui:Label name="DetailBaseStatus" text="OPERATIONAL" style="font-size: 13px; color: rgb(36, 238, 87);" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Quick Stats -->
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; padding: 12px; background-color: rgba(255,255,255,0.02); border-radius: 4px; margin-bottom: 8px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#xf133;" class="fa-icon" style="font-size: 16px; color: rgb(164, 176, 187); margin-right: 8px;" />
                        <ui:VisualElement>
                            <ui:Label text="Established" style="font-size: 11px; color: rgb(164, 176, 187);" />
                            <ui:Label name="DetailBaseEstablished" text="2018" style="font-size: 14px; color: white; -unity-font-style: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#xf1ad;" class="fa-icon" style="font-size: 16px; color: rgb(164, 176, 187); margin-right: 8px;" />
                        <ui:VisualElement>
                            <ui:Label text="Garrison Capacity" style="font-size: 11px; color: rgb(164, 176, 187);" />
                            <ui:Label name="DetailBaseGarrison" text="3,000" style="font-size: 14px; color: white; -unity-font-style: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#xf0c0;" class="fa-icon" style="font-size: 16px; color: rgb(164, 176, 187); margin-right: 8px;" />
                        <ui:VisualElement>
                            <ui:Label text="Current Personnel" style="font-size: 11px; color: rgb(164, 176, 187);" />
                            <ui:Label name="DetailBasePersonnel" text="2,450 (82%)" style="font-size: 14px; color: rgb(255, 179, 0); -unity-font-style: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#xf54b;" class="fa-icon" style="font-size: 16px; color: rgb(164, 176, 187); margin-right: 8px;" />
                        <ui:VisualElement>
                            <ui:Label text="Base Size" style="font-size: 11px; color: rgb(164, 176, 187);" />
                            <ui:Label name="DetailBaseSize" text="520 ha" style="font-size: 14px; color: white; -unity-font-style: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="&#xf132;" class="fa-icon" style="font-size: 16px; color: rgb(164, 176, 187); margin-right: 8px;" />
                        <ui:VisualElement>
                            <ui:Label text="Threat Level" style="font-size: 11px; color: rgb(164, 176, 187);" />
                            <ui:Label name="DetailBaseThreat" text="LOW" style="font-size: 14px; color: rgb(36, 238, 87); -unity-font-style: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>



                <!-- Overview Tab Content -->
                <ui:ScrollView style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                    
                    <ui:VisualElement style="flex-direction: row; margin-bottom: 12px;">
                        
                        <!-- Base Info -->
                        <ui:VisualElement style="width: 32%; background-color: rgba(255,255,255,0.015); border-radius: 4px; padding: 12px; margin-right: 8px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                            <ui:Label text="BASE INFORMATION" style="font-size: 12px; color: rgb(164, 176, 187); margin-bottom: 12px;" />
                            <ui:VisualElement name="BaseInfoListContainer" style="flex-direction: column;" />
                        </ui:VisualElement>
                        
                        <!-- Capabilities -->
                        <ui:VisualElement style="width: 32%; background-color: rgba(255,255,255,0.015); border-radius: 4px; padding: 12px; margin-right: 8px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                            <ui:Label text="CAPABILITIES" style="font-size: 12px; color: rgb(164, 176, 187); margin-bottom: 12px;" />
                            <ui:VisualElement name="BaseCapabilitiesContainer" style="flex-direction: column;" />
                        </ui:VisualElement>
                        
                        <!-- Assigned Units -->
                        <ui:VisualElement style="flex-grow: 1; background-color: rgba(255,255,255,0.015); border-radius: 4px; padding: 12px; border-width: 1px; border-color: rgba(255,255,255,0.05); justify-content: space-between;">
                            <ui:VisualElement>
                                <ui:Label text="ASSIGNED UNITS" style="font-size: 12px; color: rgb(164, 176, 187); margin-bottom: 12px;" />
                                <ui:VisualElement name="AssignedUnitsContainer" style="flex-direction: column; margin-bottom: 12px;" />
                            </ui:VisualElement>
                            <ui:Button text="MANAGE ASSIGNMENTS" class="nav-button" style="height: 28px; font-size: 12px; background-color: rgba(255,255,255,0.05); border-width: 1px; border-color: rgba(255,255,255,0.1); border-radius: 2px;" />
                        </ui:VisualElement>
                        
                    </ui:VisualElement>

                    <!-- Base Activity -->
                    <ui:VisualElement style="background-color: rgba(255,255,255,0.015); border-radius: 4px; padding: 12px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="BASE ACTIVITY (Last 7 Days)" style="font-size: 12px; color: rgb(164, 176, 187); margin-bottom: 12px;" />
                        <ui:VisualElement name="BaseActivityContainer" style="flex-direction: row; justify-content: space-around;" />
                    </ui:VisualElement>

                </ui:ScrollView>
            </ui:VisualElement>

            <!-- RIGHT COLUMN: Queues & Stats -->
            <ui:VisualElement style="width: 22%; flex-direction: column;">
                
                <!-- Overview Stats -->
                <ui:VisualElement style="margin-bottom: 12px; padding: 12px; background-color: rgba(255,255,255,0.02); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                    <ui:Label text="BASES OVERVIEW" style="font-size: 13px; color: rgb(36, 238, 87); margin-bottom: 12px;" />
                    <ui:VisualElement name="GlobalBasesOverviewContainer" style="flex-direction: column;" />
                </ui:VisualElement>

                <!-- Construction Queue -->
                <ui:VisualElement style="flex-grow: 1; margin-bottom: 12px; padding: 12px; background-color: rgba(255,255,255,0.02); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <ui:Label text="CONSTRUCTION QUEUE" style="font-size: 13px; color: rgb(36, 238, 87);" />
                        <ui:Label text="View All" style="font-size: 12px; color: rgb(36, 238, 87); cursor: link;" />
                    </ui:VisualElement>
                    <ui:ScrollView name="ConstructionQueueContainer" style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
                </ui:VisualElement>

                <!-- Upgrade Queue -->
                <ui:VisualElement style="flex-grow: 1; padding: 12px; background-color: rgba(255,255,255,0.02); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <ui:Label text="UPGRADE QUEUE" style="font-size: 13px; color: rgb(36, 238, 87);" />
                        <ui:Label text="View All" style="font-size: 12px; color: rgb(36, 238, 87); cursor: link;" />
                    </ui:VisualElement>
                    <ui:ScrollView name="UpgradeQueueContainer" style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
