<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    <ui:VisualElement name="PanelOperations" style="display: flex; flex-grow: 1; height: 100%; flex-direction: column; padding: 15px; background-color: rgb(8, 14, 20);">
        
        <!-- Top Branch Readiness Cards -->
        <ui:VisualElement name="ops-top-branches" style="flex-direction: row; justify-content: space-between; margin-bottom: 25px; flex-shrink: 0;">
            <!-- Army Card -->
            <ui:VisualElement class="ops-branch-card" style="flex-grow: 1; background-color: rgb(15, 22, 30); border-left-width: 4px; border-left-color: rgb(36, 238, 87); padding: 15px; margin-right: 15px; border-top-right-radius: 6px; border-bottom-right-radius: 6px;">
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 5px;">
                    <ui:Label text="&#xf6de;" class="fa-icon" style="color: rgb(36, 238, 87); font-size: 14px; margin-right: 8px;" />
                    <ui:Label text="army" style="color: rgb(36, 238, 87); font-size: 14px; -unity-font-style: bold; text-transform: lowercase;" />
                </ui:VisualElement>
                <ui:Label name="army-readiness" text="95% ready" style="color: white; font-size: 24px; -unity-font-style: bold; margin-bottom: 5px;" />
                <ui:Label name="army-equip" text="4,000 rifles · 1,385 APCs · 488 tanks" style="color: rgb(150, 160, 170); font-size: 12px;" />
            </ui:VisualElement>

            <!-- Air Force Card -->
            <ui:VisualElement class="ops-branch-card" style="flex-grow: 1; background-color: rgb(15, 22, 30); border-left-width: 4px; border-left-color: rgb(245, 166, 35); padding: 15px; margin-right: 15px; border-top-right-radius: 6px; border-bottom-right-radius: 6px;">
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 5px;">
                    <ui:Label text="&#xf072;" class="fa-icon" style="color: rgb(245, 166, 35); font-size: 14px; margin-right: 8px;" />
                    <ui:Label text="air force" style="color: rgb(245, 166, 35); font-size: 14px; -unity-font-style: bold; text-transform: lowercase;" />
                </ui:VisualElement>
                <ui:Label name="air-readiness" text="65% ready" style="color: white; font-size: 24px; -unity-font-style: bold; margin-bottom: 5px;" />
                <ui:Label name="air-equip" text="22 fighters · 5 bombers · 1 drone" style="color: rgb(150, 160, 170); font-size: 12px;" />
            </ui:VisualElement>

            <!-- Navy Card -->
            <ui:VisualElement class="ops-branch-card" style="flex-grow: 1; background-color: rgb(15, 22, 30); border-left-width: 4px; border-left-color: rgb(240, 80, 80); padding: 15px; margin-right: 15px; border-top-right-radius: 6px; border-bottom-right-radius: 6px;">
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 5px;">
                    <ui:Label text="&#xf21a;" class="fa-icon" style="color: rgb(240, 80, 80); font-size: 14px; margin-right: 8px;" />
                    <ui:Label text="navy" style="color: rgb(240, 80, 80); font-size: 14px; -unity-font-style: bold; text-transform: lowercase;" />
                </ui:VisualElement>
                <ui:Label name="navy-readiness" text="critical" style="color: white; font-size: 24px; -unity-font-style: bold; margin-bottom: 5px;" />
                <ui:Label name="navy-equip" text="1 frigate · 0 boats · 0 subs" style="color: rgb(150, 160, 170); font-size: 12px;" />
            </ui:VisualElement>

            <!-- RDF Card -->
            <ui:VisualElement class="ops-branch-card" style="flex-grow: 1; background-color: rgb(15, 22, 30); border-left-width: 4px; border-left-color: rgb(160, 32, 240); padding: 15px; border-top-right-radius: 6px; border-bottom-right-radius: 6px;">
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 5px;">
                    <ui:Label text="&#xf0e7;" class="fa-icon" style="color: rgb(160, 32, 240); font-size: 14px; margin-right: 8px;" />
                    <ui:Label text="rdf" style="color: rgb(160, 32, 240); font-size: 14px; -unity-font-style: bold; text-transform: lowercase;" />
                </ui:VisualElement>
                <ui:Label name="rdf-readiness" text="elite" style="color: white; font-size: 24px; -unity-font-style: bold; margin-bottom: 5px;" />
                <ui:Label name="rdf-equip" text="5,000 operators" style="color: rgb(150, 160, 170); font-size: 12px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main Content Layout (2-Column) -->
        <ui:VisualElement style="flex-direction: row; flex-grow: 1; min-height: 250px;">
            
            <!-- Left Column: Threat Recommendations & Regional Stability -->
            <ui:VisualElement style="width: 330px; margin-right: 15px; flex-shrink: 0; flex-direction: column;">
                <!-- Crisis Recommendations Card -->
                <ui:VisualElement style="background-color: rgb(12, 18, 25); border-radius: 8px; border-width: 1px; border-color: rgba(255,255,255,0.08); padding: 12px; flex-direction: column; margin-bottom: 15px; height: 180px;">
                    <ui:Label text="CRISIS RECOMMENDATIONS" style="color: rgb(0, 180, 255); font-size: 12px; -unity-font-style: bold; margin-bottom: 8px; letter-spacing: 1px;" />
                    <ui:ScrollView name="threat-list" style="flex-grow: 1;" />
                </ui:VisualElement>

                <!-- Regional Stability Overview Card -->
                <ui:VisualElement style="background-color: rgb(12, 18, 25); border-radius: 8px; border-width: 1px; border-color: rgba(255,255,255,0.08); padding: 12px; flex-direction: column; flex-grow: 1; min-height: 200px;">
                    <ui:Label text="REGIONAL STABILITY OVERVIEW" style="color: rgb(0, 180, 255); font-size: 12px; -unity-font-style: bold; margin-bottom: 8px; letter-spacing: 1px;" />
                    <ui:ScrollView name="theatre-list" style="flex-grow: 1;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Right Column: Active Operations -->
            <ui:VisualElement style="flex-grow: 1; flex-direction: column; min-height: 250px;">
                <!-- Active Operations Header -->
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-shrink: 0;">
                    <ui:Label name="lbl-active-ops-count" text="active operations (1)" style="color: white; font-size: 18px; -unity-font-style: bold; text-transform: lowercase;" />
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <!-- Inbox Button wrapper (position:relative so badge can overlap) -->
                        <ui:VisualElement name="inbox-btn-wrapper" style="position: relative; margin-right: 10px;">
                            <ui:Button name="btn-inbox" style="flex-direction: row; align-items: center; border-radius: 6px; padding: 5px 14px; -unity-font-style: bold; text-transform: none; border-width: 1px; border-color: rgba(255,255,255,0.15); background-color: transparent; color: white; font-size: 13px;">
                                <!-- FA envelope icon -->
                                <ui:Label name="inbox-icon" text="&#xf0e0;" class="fa-icon" style="color: rgb(0, 210, 255); font-size: 14px; margin-right: 6px;" />
                                <ui:Label text="INBOX" style="color: white; font-size: 12px; -unity-font-style: bold;" />
                            </ui:Button>
                            <!-- Unread badge — hidden by default, shown via C# -->
                            <ui:Label name="inbox-unread-badge" text="0" style="display: none; position: absolute; top: -4px; right: -4px; background-color: rgb(220, 40, 40); color: white; font-size: 10px; -unity-font-style: bold; border-radius: 8px; min-width: 18px; height: 18px; -unity-text-align: middle-center; padding: 0 4px;" />
                        </ui:VisualElement>
                        <ui:Button name="btn-launch-new" text="+ new operation" class="ops-btn-new" style="background-color: rgb(36, 238, 87); color: black; border-radius: 6px; padding: 6px 16px; -unity-font-style: bold; text-transform: lowercase; border-width: 0; font-size: 13px;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Main Content Area: ScrollView for operations -->
                <ui:ScrollView name="ops-master-list" style="flex-grow: 1; min-height: 200px; margin-bottom: 15px;" />
            </ui:VisualElement>
            
        </ui:VisualElement>

        <!-- Alerts Section -->
        <ui:VisualElement name="ops-alerts-container" style="flex-shrink: 0; display: none;">
            <ui:VisualElement style="background-color: rgb(12, 18, 25); border-width: 1px; border-color: rgba(255,255,255,0.1); border-radius: 8px; padding: 15px; flex-direction: row; align-items: center;">
                <ui:Label text="&#xf071;" class="fa-icon" style="color: rgb(240, 80, 80); font-size: 18px; margin-right: 15px;" />
                <ui:VisualElement>
                    <ui:Label name="alert-title" text="navy can't sustain a maritime operation" style="color: rgb(240, 80, 80); font-size: 14px; -unity-font-style: bold; text-transform: lowercase; margin-bottom: 4px;" />
                    <ui:Label name="alert-desc" text="1 frigate, no patrol boats or submarines available. procure or repair naval assets before assigning a coastal operation." style="color: rgb(150, 160, 170); font-size: 12px; text-transform: lowercase;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Operational Console Log -->
        <ui:VisualElement name="ops-console-panel" style="flex-shrink: 0; background-color: rgb(10, 15, 22); border-width: 1px; border-color: rgba(255,255,255,0.08); border-radius: 8px; padding: 10px; margin-top: 10px; height: 110px;">
            <ui:Label text="OPERATIONAL CONSOLE LOG" style="color: rgb(0, 180, 255); font-size: 9px; -unity-font-style: bold; margin-bottom: 5px; letter-spacing: 1px;" />
            <ui:ScrollView name="ops-console-scroll" style="flex-grow: 1; min-height: 0;" />
        </ui:VisualElement>

        <!-- HIDDEN CONTAINER FOR ACCORDION DETAIL VIEW -->
        <ui:VisualElement name="ops-detail-container" style="display: none;">
            <!-- Original ops-detail-view (kept intact for C# logic) -->
            <ui:VisualElement name="ops-detail-view" style="flex-direction: row; padding: 15px; margin-top: 15px; background-color: rgba(12, 18, 25, 0.95); border-radius: 8px; border-width: 1px; border-color: rgba(255,255,255,0.1); flex-shrink: 0;">
            <!-- Center-Left: Stats and Resources -->
            <ui:VisualElement style="flex-grow: 1; flex-direction: column; margin-right: 15px; min-width: 0;">
                <!-- Header Card -->
                <ui:VisualElement class="ops-card" style="flex-direction: row; justify-content: space-between; margin-bottom: 15px; flex-shrink: 0;">
                    <ui:VisualElement>
                        <ui:Label name="det-op-name" text="OPERATION: LAGOS SHIELD" class="det-title" />
                        <ui:Label name="det-op-type" text="Counter Terrorism Operation" class="det-subtitle" />
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: flex-end;">
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:VisualElement class="status-dot active" />
                            <ui:Label name="det-op-status" text="ACTIVE" class="det-status" />
                        </ui:VisualElement>
                        <ui:Label name="det-start-date" text="Started: 02 Jan 2026" class="det-date" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 6 Stat blocks in a row -->
                <ui:VisualElement class="ops-card" style="flex-direction: row; flex-wrap: wrap; margin-bottom: 15px; padding: 10px 5px; flex-shrink: 0;">
                    <ui:VisualElement class="det-stat-box"><ui:VisualElement class="det-stat-icon" style="width: 14px; height: 14px; margin-right: 6px; background-image: url('project://database/Assets/Images/MilitaryIcons/icon_bases.png'); -unity-background-scale-mode: scale-to-fit;"/><ui:VisualElement><ui:Label text="REGION" class="det-stat-key"/><ui:Label name="stat-region" text="-" class="det-stat-val"/></ui:VisualElement></ui:VisualElement>
                    <ui:VisualElement class="det-stat-box"><ui:VisualElement class="det-stat-icon" style="width: 14px; height: 14px; margin-right: 6px; background-image: url('project://database/Assets/Images/MilitaryIcons/icon_target.png'); -unity-background-scale-mode: scale-to-fit;"/><ui:VisualElement><ui:Label text="PRIMARY OBJECTIVE" class="det-stat-key"/><ui:Label name="stat-objective" text="-" class="det-stat-val"/></ui:VisualElement></ui:VisualElement>
                    <ui:VisualElement class="det-stat-box"><ui:VisualElement class="det-stat-icon" style="width: 14px; height: 14px; margin-right: 6px; background-image: url('project://database/Assets/Images/MilitaryIcons/icon_time.png'); -unity-background-scale-mode: scale-to-fit;"/><ui:VisualElement><ui:Label text="DURATION" class="det-stat-key"/><ui:Label name="stat-duration" text="- / -" class="det-stat-val"/></ui:VisualElement></ui:VisualElement>
                    <ui:VisualElement class="det-stat-box"><ui:VisualElement class="det-stat-icon" style="width: 14px; height: 14px; margin-right: 6px; background-image: url('project://database/Assets/Images/MilitaryIcons/icon_defend.png'); -unity-background-scale-mode: scale-to-fit;"/><ui:VisualElement><ui:Label text="SUCCESS CHANCE" class="det-stat-key"/><ui:Label name="stat-chance" text="-" class="det-stat-val"/></ui:VisualElement></ui:VisualElement>
                    <ui:VisualElement class="det-stat-box"><ui:VisualElement class="det-stat-icon" style="width: 14px; height: 14px; margin-right: 6px; background-image: url('project://database/Assets/Images/MilitaryIcons/icon_report.png'); -unity-background-scale-mode: scale-to-fit;"/><ui:VisualElement><ui:Label text="INTEL QUALITY" class="det-stat-key"/><ui:Label name="stat-intel" text="-" class="det-stat-val"/></ui:VisualElement></ui:VisualElement>
                    <ui:VisualElement class="det-stat-box"><ui:VisualElement class="det-stat-icon" style="width: 14px; height: 14px; margin-right: 6px; background-image: url('project://database/Assets/Images/MilitaryIcons/icon_attack.png'); -unity-background-scale-mode: scale-to-fit;"/><ui:VisualElement><ui:Label text="THREAT LEVEL" class="det-stat-key"/><ui:Label name="stat-threat" text="-" class="det-stat-val"/></ui:VisualElement></ui:VisualElement>
                </ui:VisualElement>

                <!-- Grid for Forces, Equipment, Status, Resources -->
                <ui:VisualElement style="flex-direction: row; flex-grow: 1;">
                    <!-- Left side -->
                    <ui:VisualElement style="flex-grow: 1; margin-right: 15px; flex-direction: column;">
                        <ui:VisualElement class="ops-card" style="margin-bottom: 15px; flex-grow: 1; min-height: 120px;">
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px; flex-shrink: 0;">
                                <ui:Label text="FORCES ASSIGNED" class="ops-section-header" />
                            </ui:VisualElement>
                            <ui:ScrollView name="det-forces-list" style="height: 100px;" />
                        </ui:VisualElement>

                        <ui:VisualElement class="ops-card" style="flex-grow: 1; min-height: 120px;">
                            <ui:Label text="EQUIPMENT ASSIGNED" class="ops-section-header" style="margin-bottom: 10px; flex-shrink: 0;" />
                            <ui:ScrollView name="det-equip-list" style="height: 100px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Right side -->
                    <ui:VisualElement style="flex-grow: 1; flex-direction: column;">
                        <ui:VisualElement class="ops-card" style="margin-bottom: 15px; flex-grow: 1; min-height: 220px;">
                            <ui:Label text="OPERATION STATUS" class="ops-section-header" style="margin-bottom: 10px; flex-shrink: 0;" />
                            <ui:ScrollView name="det-status-list" style="flex-grow: 1; min-height: 200px;" />
                        </ui:VisualElement>

                        <ui:VisualElement class="ops-card" style="flex-grow: 1; min-height: 110px;">
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px; flex-shrink: 0;">
                                <ui:Label text="OPERATION RESOURCES" class="ops-section-header" />
                                <ui:VisualElement style="flex-direction: row; align-items: flex-end;">
                                    <ui:Label text="Estimated Monthly Cost " style="font-size: 12px; color: grey; margin-right: 6px;" />
                                    <ui:Label name="stat-cost" text="-" style="font-size: 14px; color: white; -unity-font-style: bold;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:ScrollView name="det-res-list" style="height: 90px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Mission Feed -->
                <ui:VisualElement class="ops-card" style="height: 140px; margin-top: 15px; flex-shrink: 0;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px;">
                        <ui:Label text="MISSION FEED (LIVE UPDATES)" class="ops-section-header" />
                        <ui:Button name="btn-view-feed" text="VIEW ALL" class="ops-btn-small" />
                    </ui:VisualElement>
                    <ui:ScrollView name="det-feed-list" style="flex-grow: 1;" />
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Right: Mission Outlook & Actions -->
            <ui:VisualElement class="ops-col-right" style="width: 250px; flex-shrink: 0; flex-direction: column;">
                <ui:VisualElement class="ops-card" style="margin-bottom: 15px;">
                    <ui:Label text="MISSION OUTLOOK" class="ops-section-header" style="margin-bottom: 15px;" />
                    <ui:VisualElement style="align-items: center; justify-content: center; margin-bottom: 15px;">
                        <!-- Mock Circular Gauge -->
                        <ui:VisualElement style="width: 100px; height: 100px; border-radius: 50%; border-width: 4px; border-color: rgba(36, 238, 87, 0.2); justify-content: center; align-items: center;">
                            <ui:VisualElement name="gauge-fill" style="position: absolute; top: -4px; left: -4px; right: -4px; bottom: -4px; border-radius: 50%; border-width: 4px; border-top-color: rgb(36, 238, 87); border-right-color: rgb(36, 238, 87); border-bottom-color: transparent; border-left-color: transparent; rotate: 45deg;" />
                            <ui:Label name="stat-success-main" text="-" style="font-size: 27px; color: white; -unity-font-style: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 4px;">
                        <ui:Label text="• Success Probability" style="color: grey; font-size: 13px;" />
                        <ui:Label name="out-prob" text="-" style="color: white; font-size: 13px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 4px;">
                        <ui:Label text="• Friendly Losses" style="color: grey; font-size: 13px;" />
                        <ui:Label name="out-losses" text="-" style="color: white; font-size: 13px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 4px;">
                        <ui:Label text="• Civilian Risk" style="color: grey; font-size: 13px;" />
                        <ui:Label name="out-civ" text="-" style="color: white; font-size: 13px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 4px;">
                        <ui:Label text="• Political Impact" style="color: grey; font-size: 13px;" />
                        <ui:Label name="out-pol" text="-" style="color: rgb(36, 238, 87); font-size: 13px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                        <ui:Label text="• Intel Confidence" style="color: grey; font-size: 13px;" />
                        <ui:Label name="out-intel" text="-" style="color: white; font-size: 13px; -unity-font-style: bold;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="ops-card" style="margin-bottom: 15px; flex-grow: 1; min-height: 180px;">
                    <ui:Label text="COMMAND DECISIONS" class="ops-section-header" style="margin-bottom: 10px; flex-shrink: 0;" />
                    <ui:ScrollView name="det-cmd-decisions-scroll" style="flex-grow: 1;">
                        <ui:Button name="btn-action-airstrike" class="ops-action-btn">
                            <ui:VisualElement class="action-icon" style="width: 16px; height: 16px; margin-right: 8px; background-image: url('project://database/Assets/Images/MilitaryIcons/icon_attack.png'); -unity-background-scale-mode: scale-to-fit;" />
                            <ui:VisualElement>
                                <ui:Label text="Call Air Strike" class="action-title" />
                                <ui:Label text="Request precision air strike on target." class="action-desc" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="btn-action-recon" class="ops-action-btn">
                            <ui:VisualElement class="action-icon" style="width: 16px; height: 16px; margin-right: 8px; background-image: url('project://database/Assets/Images/MilitaryIcons/icon_eyes.png'); -unity-background-scale-mode: scale-to-fit;" />
                            <ui:VisualElement>
                                <ui:Label text="Deploy Recon Drone" class="action-title" />
                                <ui:Label text="Launch drone for area surveillance." class="action-desc" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="btn-action-reinforce" class="ops-action-btn">
                            <ui:VisualElement class="action-icon" style="width: 16px; height: 16px; margin-right: 8px; background-image: url('project://database/Assets/Images/MilitaryIcons/icon_defend.png'); -unity-background-scale-mode: scale-to-fit;" />
                            <ui:VisualElement>
                                <ui:Label text="Reinforce Operation" class="action-title" />
                                <ui:Label text="Send additional troops and equipment." class="action-desc" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="btn-action-intel" class="ops-action-btn">
                            <ui:VisualElement class="action-icon" style="width: 16px; height: 16px; margin-right: 8px; background-image: url('project://database/Assets/Images/MilitaryIcons/icon_report.png'); -unity-background-scale-mode: scale-to-fit;" />
                            <ui:VisualElement>
                                <ui:Label text="Request Intelligence" class="action-title" />
                                <ui:Label text="Request updated intelligence report." class="action-desc" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:ScrollView>
                </ui:VisualElement>

                <ui:VisualElement class="ops-card" style="flex-shrink: 0;">
                    <ui:Label text="OPERATION ACTIONS" class="ops-section-header" style="margin-bottom: 10px;" />
                    <ui:Button name="btn-op-abort" text="ABORT OPERATION" class="ops-btn-abort" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
