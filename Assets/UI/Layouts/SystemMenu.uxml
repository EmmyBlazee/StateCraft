<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    <ui:VisualElement name="SystemMenuRoot" style="flex-grow: 1; background-color: rgba(5, 8, 12, 0.85); align-items: center; justify-content: center; position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; z-index: 9999;">
        
        <ui:VisualElement class="hologram-border" style="width: 350px; padding: 30px; background-color: rgba(10, 14, 20, 0.95); border-radius: 8px; border-width: 1px; border-color: rgba(0, 200, 255, 0.3);">
            
            <ui:Label text="PAUSED" style="font-size: 28px; color: rgb(0, 200, 255); -unity-font-style: bold; -unity-text-align: middle-center; letter-spacing: 3px; margin-bottom: 25px;" />
            
            <ui:Button name="BtnResume" text="RESUME" class="standard-button action-btn-blue" style="margin-bottom: 12px; font-size: 16px; height: 45px; letter-spacing: 1px;" />
            
            <ui:Button name="BtnSave" text="SAVE GAME" class="standard-button action-btn-green" style="margin-bottom: 12px; font-size: 16px; height: 45px; letter-spacing: 1px;" />
            
            <ui:Button name="BtnLoad" text="LOAD GAME" class="standard-button action-btn-orange" style="margin-bottom: 12px; font-size: 16px; height: 45px; letter-spacing: 1px;" />
            
            <ui:Button name="BtnHowToPlay" text="HOW TO PLAY" class="standard-button action-btn-blue" style="margin-bottom: 12px; font-size: 16px; height: 45px; letter-spacing: 1px;" />
            
            <ui:Button name="BtnQuitToMenu" text="QUIT TO MENU" class="standard-button action-btn-red" style="margin-bottom: 0px; font-size: 16px; height: 45px; letter-spacing: 1px;" />

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
