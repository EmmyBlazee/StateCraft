<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    <ui:VisualElement name="MainMenuRoot" style="flex-grow: 1; background-color: rgba(5, 8, 12, 0.98); align-items: center; justify-content: center;">
        
        <ui:VisualElement name="BackgroundGlow" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 150, 255, 0.05); align-items: center; justify-content: center;" />

        <ui:VisualElement name="MenuContainer" class="hologram-border" style="width: 450px; padding: 40px; background-color: rgba(10, 14, 20, 0.85); border-radius: 8px; border-width: 1px; border-color: rgba(0, 200, 255, 0.3);">
            
            <ui:Label text="STATE CRAFT" style="font-size: 42px; color: rgb(0, 200, 255); -unity-font-style: bold; -unity-text-align: middle-center; letter-spacing: 4px; margin-bottom: 5px; text-shadow: 0 0 10px rgba(0, 200, 255, 0.5);" />
            <ui:Label text="GLOBAL STRATEGY SIMULATOR" style="font-size: 14px; color: rgb(150, 150, 150); -unity-font-style: italic; -unity-text-align: middle-center; letter-spacing: 2px; margin-bottom: 40px;" />

            <ui:Button name="BtnNewGame" text="NEW GAME" class="standard-button action-btn-green" style="margin-bottom: 15px; font-size: 18px; height: 50px; letter-spacing: 2px;" />
            
            <ui:Button name="BtnLoadGame" text="LOAD GAME" class="standard-button action-btn-blue" style="margin-bottom: 15px; font-size: 18px; height: 50px; letter-spacing: 2px;" />
            
            <ui:Button name="BtnHowToPlay" text="HOW TO PLAY" class="standard-button action-btn-orange" style="margin-bottom: 15px; font-size: 18px; height: 50px; letter-spacing: 2px;" />

            <ui:Button name="BtnSettings" text="SETTINGS" class="standard-button" style="margin-bottom: 15px; font-size: 18px; height: 50px; letter-spacing: 2px;" />
            
            <ui:Button name="BtnQuit" text="QUIT TO DESKTOP" class="standard-button action-btn-red" style="margin-bottom: 0px; font-size: 18px; height: 50px; letter-spacing: 2px;" />

        </ui:VisualElement>

        <ui:Label text="v1.0.0-alpha" style="position: absolute; bottom: 20px; right: 20px; color: rgba(255,255,255,0.2); font-size: 12px; letter-spacing: 1px;" />

    </ui:VisualElement>
</ui:UXML>
