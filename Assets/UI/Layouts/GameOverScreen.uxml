<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />

    <!-- Full-screen game over overlay -->
    <ui:VisualElement name="GameOverRoot" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(4, 6, 10, 0.98); align-items: center; justify-content: center; display: none; z-index: 9999;">

        <ui:VisualElement name="BackgroundGlow" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(255, 0, 0, 0.05); align-items: center; justify-content: center;" />

        <ui:VisualElement name="GameOverPanel" class="hologram-border" style="width: 600px; padding: 40px; background-color: rgba(10, 14, 20, 0.9); border-radius: 8px; border-width: 1px; border-color: rgba(255, 50, 50, 0.3);">
            
            <ui:Label name="GameOverTitle" text="GOVERNMENT COLLAPSED" style="font-size: 36px; color: rgb(255, 50, 50); -unity-font-style: bold; -unity-text-align: middle-center; letter-spacing: 4px; margin-bottom: 20px; text-shadow: 0 0 10px rgba(255, 50, 50, 0.5);" />
            
            <ui:Label name="GameOverSummary" text="Your nation has fallen into ruin. The people demand a new leadership." style="font-size: 14px; color: rgb(200, 200, 210); white-space: normal; -unity-text-align: middle-center; margin-bottom: 30px;" />

            <ui:VisualElement style="background-color: rgba(0, 0, 0, 0.4); border-radius: 6px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1); padding: 20px; margin-bottom: 30px;">
                <ui:Label text="FINAL STATISTICS" style="font-size: 12px; color: rgb(150, 150, 150); -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 10px;" />
                <ui:Label name="GameOverStats" text="• Prestige: 42\n• Stability: 0%\n• Treasury: -$12B" style="font-size: 14px; color: rgb(0, 200, 255); white-space: normal; line-height: 24px;" />
            </ui:VisualElement>

            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Button name="BtnSaveScreenshot" text="SAVE SCREENSHOT" class="button-premium" style="margin-bottom: 0px; font-size: 14px; height: 50px; letter-spacing: 1px; flex-grow: 1; margin-right: 10px; color: rgb(0, 230, 118); border-color: rgba(0, 230, 118, 0.5); background-color: rgba(0, 230, 118, 0.08); -unity-font-style: bold;" />
                <ui:Button name="BtnQuitToMenuFromGameOver" text="QUIT TO MAIN MENU" class="button-premium" style="margin-bottom: 0px; font-size: 14px; height: 50px; letter-spacing: 1px; flex-grow: 1; color: rgb(0, 210, 255); border-color: rgba(0, 210, 255, 0.5); background-color: rgba(0, 210, 255, 0.08); -unity-font-style: bold;" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
