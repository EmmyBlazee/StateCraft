                                    </ui:VisualElement>
                                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 3px;">
                                        <ui:Label text="Readiness" style="font-size: 12px; color: rgb(160,160,160);" />
                                        <ui:ProgressBar name="AFReadinessBar" value="65" style="width: 60%; height: 6px;" />
                                        <ui:Label name="AFReadinessPct" text="65%" style="font-size: 12px; color: rgb(255,180,0); -unity-font-style: bold;" />
                                    </ui:VisualElement>
                                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                        <ui:Label text="Morale" style="font-size: 12px; color: rgb(160,160,160);" />
                                        <ui:ProgressBar name="AFMoraleBar" value="60" style="width: 60%; height: 6px;" />
                                        <ui:Label name="AFMoralePct" text="60%" style="font-size: 12px; color: rgb(255,180,0); -unity-font-style: bold;" />
                                    </ui:VisualElement>
                                    <ui:VisualElement style="display: none; flex-direction: row; align-items: center; background-color: rgba(0,0,0,0.3); border-radius: 4px; padding: 4px; border-top-width: 1px; border-top-color: rgba(255,255,255,0.08);">
                                        <ui:VisualElement name="AFCdrPortrait" style="width: 28px; height: 28px; border-radius: 14px; background-color: rgba(186,104,200,0.2); margin-right: 8px; border-width: 1px; border-color: rgba(186,104,200,0.4);" />
                                        <ui:VisualElement style="flex-grow: 1;">
