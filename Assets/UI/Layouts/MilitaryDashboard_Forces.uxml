                                        <ui:Label text="Personnel" style="font-size: 12px; color: rgb(160,160,160);" />
                                        <ui:Label name="AFPersonnel" text="18,650" style="font-size: 12px; color: white; -unity-font-style: bold;" />
                                    </ui:VisualElement>
                                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 3px;">
                                        <ui:Label text="Equipment" style="font-size: 12px; color: rgb(160,160,160);" />
