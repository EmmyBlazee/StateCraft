                            <ui:Label name="TA_Trend30" text="RISING" style="font-size: 16px; -unity-font-style: bold; color: rgb(255, 82, 82);" />
                        </ui:VisualElement>
                        <ui:Button text="&#xf15c;  REPORT" class="fa-icon" style="height: 28px; padding-left: 12px; padding-right: 12px; font-size: 13px; background-color: rgba(255, 255, 255, 0.05); border-color: rgba(255,255,255,0.1); border-width: 1px; border-radius: 2px; color: white;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ROW 1 (TOP) -->
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; min-height: 0; margin-bottom: 12px;">
                    <!-- Threat Matrix -->
                    <ui:VisualElement class="sub-panel" style="width: 28%; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="THREAT MATRIX" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:VisualElement name="TA_MatrixGrid" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap;" />
                    </ui:VisualElement>

                    <!-- Top Threats -->
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="TOP THREATS" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:VisualElement style="flex-direction: row; border-bottom-width: 1px; border-color: rgba(255,255,255,0.1); padding-bottom: 6px; margin-bottom: 6px;">
                            <ui:Label text="THREAT" style="font-size: 11px; color: grey; width: 140px;" />
                            <ui:Label text="CATEGORY" style="font-size: 11px; color: grey; flex-grow: 1;" />
                            <ui:Label text="IMPACT" style="font-size: 11px; color: grey; width: 60px;" />
                            <ui:Label text="LIKELIHOOD" style="font-size: 11px; color: grey; width: 60px;" />
                            <ui:Label text="TREND" style="font-size: 11px; color: grey; width: 40px; -unity-text-align: middle-center;" />
                            <ui:Label text="RISK LEVEL" style="font-size: 11px; color: grey; width: 60px; -unity-text-align: middle-right;" />
                        </ui:VisualElement>
                        <ui:ScrollView name="TA_TopThreatsList" style="flex-grow: 1;" />
                    </ui:VisualElement>

                    <!-- Threat Categories -->
                    <ui:VisualElement class="sub-panel" style="width: 25%; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="THREAT CATEGORIES" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; flex-grow: 1;">
                            <ui:VisualElement style="width: 80px; height: 80px; border-radius: 40px; border-width: 8px; border-color: rgba(255,255,255,0.1); align-items: center; justify-content: center;">
                                <ui:Label name="TA_CatDonut" text="0" style="font-size: 18px; color: white; -unity-font-style: bold;" />
                                <ui:Label text="TOTAL" style="font-size: 10px; color: grey;" />
                            </ui:VisualElement>
                            <ui:VisualElement name="TA_CategoryList" style="flex-grow: 1; margin-left: 16px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ROW 2 (MIDDLE) -->
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; min-height: 0; margin-bottom: 12px;">
                    <!-- Regional Overview -->
                    <ui:VisualElement class="sub-panel" style="width: 28%; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="REGIONAL THREAT OVERVIEW" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:VisualElement name="TA_RegionList" style="flex-grow: 1;" />
                    </ui:VisualElement>

                    <!-- Threat Level Over Time -->
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 12px;">
                            <ui:Label text="THREAT LEVEL OVER TIME" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; letter-spacing: 1px;" />
                            <ui:Label text="Last 90 Days" style="font-size: 12px; color: grey; background-color: rgba(255,255,255,0.05); padding-left: 6px; padding-right: 6px; border-radius: 2px;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="TA_TrendChart" style="flex-grow: 1; flex-direction: row; align-items: flex-end; justify-content: space-between; padding-top: 20px;" />
                    </ui:VisualElement>

                    <!-- Countries of Concern -->
                    <ui:VisualElement class="sub-panel" style="width: 32%; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="COUNTRIES OF CONCERN" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:VisualElement style="flex-direction: row; border-bottom-width: 1px; border-color: rgba(255,255,255,0.1); padding-bottom: 6px; margin-bottom: 6px;">
                            <ui:Label text="COUNTRY" style="font-size: 11px; color: grey; width: 70px;" />
                            <ui:Label text="CONCERN LEVEL" style="font-size: 11px; color: grey; width: 80px; -unity-text-align: middle-center;" />
                            <ui:Label text="REASON" style="font-size: 11px; color: grey; flex-grow: 1;" />
                            <ui:Label text="TREND" style="font-size: 11px; color: grey; width: 30px; -unity-text-align: middle-center;" />
                        </ui:VisualElement>
                        <ui:ScrollView name="TA_CountriesList" style="flex-grow: 1;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ROW 3 (BOTTOM) -->
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; min-height: 0;">
                    <!-- Critical Threats -->
                    <ui:VisualElement class="sub-panel" style="width: 45%; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="CRITICAL THREATS (REQUIRING IMMEDIATE ATTENTION)" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:VisualElement name="TA_CriticalCards" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; justify-content: space-between;" />
                    </ui:VisualElement>

                    <!-- Mitigation Progress -->
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="MITIGATION PROGRESS" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:ScrollView name="TA_MitigationList" style="flex-grow: 1;" />
                    </ui:VisualElement>

                    <!-- Recommendations -->
                    <ui:VisualElement class="sub-panel" style="width: 25%; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="RECOMMENDATIONS" style="font-size: 13px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:ScrollView name="TA_RecommendationsList" style="flex-grow: 1;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

