<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />
    <ui:VisualElement name="IntelligenceDashboard" class="standard-dashboard hologram-border" style="display: none; padding: 12px;">

        <!-- HEADER -->
        <ui:VisualElement name="Header" class="econ-topbar">
            <ui:VisualElement class="econ-country-block">
                <ui:VisualElement>
                    <ui:VisualElement class="econ-country-line">
                        <ui:Label text="INTELLIGENCE" class="econ-country-name" />
                        <ui:Label text="&#xf21b;" class="fa-icon econ-flag" style="font-size: 23px; color: rgb(214, 223, 230); background-color: transparent; width: auto;" />
                    </ui:VisualElement>
                    <ui:Label text="National Intelligence Agency" class="econ-country-subtitle" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="econ-kpi-strip">
                <ui:VisualElement class="econ-kpi"><ui:Label text="INTEL COVERAGE" class="econ-kpi-label" /><ui:Label name="HdrIntelCoverage" text="—" class="econ-kpi-value" /><ui:Label name="HdrIntelCoverageRating" text="Global" class="econ-kpi-delta neutral" style="color: rgb(150,150,150);" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="OPERATIVES" class="econ-kpi-label" /><ui:Label name="HdrOperatives" text="—" class="econ-kpi-value" /><ui:Label text="Active Agents" class="econ-kpi-delta neutral" style="color: rgb(150,150,150);" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="COVERT OPS" class="econ-kpi-label" /><ui:Label name="HdrCovertOps" text="—" class="econ-kpi-value" /><ui:Label name="HdrCovertOpsSub" text="Active" class="econ-kpi-delta warning" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="SATELLITES" class="econ-kpi-label" /><ui:Label name="HdrSatellites" text="—" class="econ-kpi-value" /><ui:Label text="Orbital Assets" class="econ-kpi-delta neutral" style="color: rgb(150,150,150);" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="EXPOSURE RISK" class="econ-kpi-label" /><ui:Label name="HdrExposureRisk" text="—" class="econ-kpi-value" /><ui:Label name="HdrExposureRiskSub" text="Network Safe" class="econ-kpi-delta positive" /></ui:VisualElement>
                <ui:VisualElement class="econ-kpi"><ui:Label text="INTEL BUDGET" class="econ-kpi-label" /><ui:Label name="HdrIntelBudgetTop" text="—" class="econ-kpi-value" /><ui:Label text="Per Turn" class="econ-kpi-delta neutral" style="color: rgb(150,150,150);" /></ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="econ-date-box">
                <ui:Label name="DateMain" text="08 JAN 2026" class="econ-date-main" />
                <ui:Label name="DateSub" text="Thursday, 09:12" class="econ-date-sub" />
            </ui:VisualElement>
            <ui:Button name="CloseIntelligence" text="×" class="econ-icon-button" />
        </ui:VisualElement>

        <!-- SUB-TAB NAVIGATION -->
        <ui:VisualElement name="SubTabs" style="flex-direction: row; margin-top: 15px; margin-bottom: 12px;">
            <ui:Button name="TabOverview" text="OVERVIEW" class="nav-button active-tab" style="flex-grow: 1; height: 32px; font-size: 15px; margin-right: 2px;" />
            <ui:Button name="TabIntelNetwork" text="INTELLIGENCE NETWORK" class="nav-button" style="display: none; flex-grow: 1; height: 32px; font-size: 15px; margin-right: 2px;" />
            <ui:Button name="TabRecon" text="RECON &amp; SURVEILLANCE" class="nav-button" style="display: none; flex-grow: 1; height: 32px; font-size: 15px; margin-right: 2px;" />
            <ui:Button name="TabCovertOps" text="COVERT OPERATIONS" class="nav-button" style="flex-grow: 1; height: 32px; font-size: 15px; margin-right: 2px;" />
            <ui:Button name="TabDataAnalysis" text="DATA &amp; ANALYSIS" class="nav-button" style="display: none; flex-grow: 1; height: 32px; font-size: 15px; margin-right: 2px;" />
            <ui:Button name="TabThreats" text="THREAT ASSESSMENT" class="nav-button" style="flex-grow: 1; height: 32px; font-size: 15px;" />
        </ui:VisualElement>

        <!-- CONTENT PANELS -->
        <ui:VisualElement name="PanelContainer" style="flex-grow: 1; min-height: 0;">
            
            <!-- 1. OVERVIEW TAB (NEW) -->
            <ui:VisualElement name="PanelOverview" style="display: flex; height: 100%; flex-direction: row;">
                
                <!-- LEFT COLUMN: THREAT MATRIX -->
                <ui:VisualElement style="width: 30%; min-width: 300px; margin-right: 12px; flex-direction: column;">
                    
                    <!-- OVERALL THREAT LEVEL -->
                    <ui:VisualElement name="OverviewThreatCard" class="sub-panel" style="padding: 16px; margin-bottom: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255, 50, 50, 0.3);">
                        <ui:Label name="OverviewThreatTitle" text="NATIONAL THREAT LEVEL" style="font-size: 13px; color: rgba(255, 100, 100, 0.8); -unity-font-style: bold; margin-bottom: 8px; letter-spacing: 2px;" />
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label name="OverviewThreatIcon" text="&#xf071;" class="fa-icon" style="font-size: 34px; color: rgb(255, 50, 50); margin-right: 12px;" />
                            <ui:VisualElement>
                                <ui:Label name="OverviewThreatLevel" text="CRITICAL" style="font-size: 26px; color: rgb(255, 50, 50); -unity-font-style: bold;" />
                                <ui:Label name="OverviewThreatSubtext" text="Immediate Action Required" style="font-size: 12px; color: rgba(255, 50, 50, 0.6);" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- THREAT MATRIX LIST -->
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); min-height: 0;">
                        <ui:Label text="ACTIVE THREATS" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:ScrollView name="OverviewThreatMatrixList" style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                    </ui:VisualElement>
                    
                </ui:VisualElement>
                
                <!-- MIDDLE COLUMN: INTEL FEED -->
                <ui:VisualElement style="flex-grow: 1; margin-right: 12px; flex-direction: column; min-width: 350px;">
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); min-height: 0;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <ui:Label text="INTERCEPTED INTEL FEED" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; letter-spacing: 1px;" />
                            <ui:VisualElement style="flex-direction: row; align-items: center;">
                                <ui:VisualElement style="width: 8px; height: 8px; border-radius: 4px; background-color: rgb(36, 238, 87); margin-right: 6px;" />
                                <ui:Label text="LIVE" style="font-size: 12px; color: rgb(36, 238, 87); -unity-font-style: bold; letter-spacing: 1px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:ScrollView name="OverviewIntelFeedList" style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <!-- RIGHT COLUMN: BLINDSPOTS -->
                <ui:VisualElement style="width: 30%; min-width: 300px; flex-direction: column;">
                    
                    <ui:VisualElement class="sub-panel" style="flex-grow: 1; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); min-height: 0;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <ui:Label text="CRITICAL BLINDSPOTS" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; letter-spacing: 1px;" />
                            <ui:Label text="Deploy Recon" style="font-size: 13px; color: rgb(36, 238, 87); cursor: link;" />
                        </ui:VisualElement>
                        
                        <ui:Label text="These regions lack sufficient intelligence coverage. Unknown threats may be developing undetected." style="font-size: 12px; color: rgba(214, 223, 230, 0.5); white-space: normal; margin-bottom: 12px;" />

                        <ui:ScrollView name="OverviewBlindspotsList" style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- KEEP EXISTING TABS BUT HIDE THEM -->
            <ui:VisualElement name="PanelSurveillance" style="display: none; height: 100%; flex-direction: column;">
                
                <!-- TOP HEADER STRIP -->
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; background-color: rgba(10, 14, 20, 0.95); padding: 12px; margin-bottom: 12px; border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                    <ui:VisualElement style="flex-direction: row; align-items: center; width: 25%;">
                        <ui:Label text="&#xf05b;" class="fa-icon" style="font-size: 27px; color: rgb(214, 223, 230); margin-right: 12px;" />
                        <ui:VisualElement>
                            <ui:Label text="RECON &amp; SURVEILLANCE" style="font-size: 18px; color: white; -unity-font-style: bold;" />
                            <ui:Label text="Monitor, detect and collect intelligence through all available assets." style="font-size: 14px; color: grey; margin-top: 2px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 70%;">
                        <ui:VisualElement class="econ-kpi" style="border-right-width: 1px; border-color: rgba(255,255,255,0.1); padding-right: 15px; margin-right: 15px;">
                            <ui:Label text="SURVEILLANCE ASSETS" class="econ-kpi-label" />
                            <ui:VisualElement style="flex-direction: row; align-items: baseline;">
                                <ui:Label text="&#xf2b9;" class="fa-icon" style="font-size: 16px; color: rgb(35, 237, 86); margin-right: 4px;" />
                                <ui:Label name="RS_TotalAssets" text="24" class="econ-kpi-value" style="font-size: 20px;" />
                            </ui:VisualElement>
                            <ui:Label name="RS_OnlineAssets" text="Online: 18" class="econ-kpi-delta positive" />
                        </ui:VisualElement>
                        <ui:VisualElement class="econ-kpi" style="border-right-width: 1px; border-color: rgba(255,255,255,0.1); padding-right: 15px; margin-right: 15px;">
                            <ui:Label text="MISSIONS IN PROGRESS" class="econ-kpi-label" />
                            <ui:VisualElement style="flex-direction: row; align-items: baseline;">
                                <ui:Label text="&#xf0b1;" class="fa-icon" style="font-size: 16px; color: rgb(214, 223, 230); margin-right: 4px;" />
                                <ui:Label name="RS_TotalMissions" text="7" class="econ-kpi-value" style="font-size: 20px;" />
                            </ui:VisualElement>
                            <ui:Label name="RS_HighPriority" text="High Priority: 2" class="econ-kpi-delta warning" />
                        </ui:VisualElement>
                        <ui:VisualElement class="econ-kpi" style="border-right-width: 1px; border-color: rgba(255,255,255,0.1); padding-right: 15px; margin-right: 15px;">
                            <ui:Label text="INTEL COLLECTION RATE" class="econ-kpi-label" />
                            <ui:Label name="RS_CollectionRate" text="71%" class="econ-kpi-value" style="font-size: 20px;" />
                            <ui:Label name="RS_CollectionStatus" text="Good" class="econ-kpi-delta positive" />
                        </ui:VisualElement>
                        <ui:VisualElement class="econ-kpi" style="border-right-width: 1px; border-color: rgba(255,255,255,0.1); padding-right: 15px; margin-right: 15px;">
                            <ui:Label text="DETECTION RATE" class="econ-kpi-label" />
                            <ui:Label name="RS_DetectionRate" text="63%" class="econ-kpi-value" style="font-size: 20px;" />
                            <ui:Label name="RS_DetectionStatus" text="Moderate" class="econ-kpi-delta warning" />
                        </ui:VisualElement>
                        <ui:VisualElement class="econ-kpi">
                            <ui:Label text="FUSION ACCURACY" class="econ-kpi-label" />
                            <ui:Label name="RS_FusionAccuracy" text="86%" class="econ-kpi-value" style="font-size: 20px;" />
                            <ui:Label name="RS_FusionStatus" text="High" class="econ-kpi-delta positive" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 2-COLUMN LAYOUT -->
                <ui:VisualElement style="flex-direction: row; flex-grow: 1;">
                    
                    <!-- LEFT COLUMN (Main Content - 75%) -->
                    <ui:VisualElement style="width: 75%; padding-right: 12px; flex-direction: column;">
                        
                        <!-- ROW 1 -->
                        <ui:VisualElement style="flex-direction: row; min-height: 200px; margin-bottom: 12px; justify-content: space-between;">
                            <!-- COL 1: SURVEILLANCE ASSETS -->

                    <ui:VisualElement style="width: 48%; margin-right: 12px; flex-direction: column;">
                        <ui:VisualElement class="sub-panel" style="flex-grow: 1; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); min-height: 0;">
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                <ui:Label text="SURVEILLANCE ASSETS" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; letter-spacing: 1px;" />
                                <ui:Label name="RS_AssetHeaderCounts" text="18 Online / 24 Total" style="font-size: 14px; color: rgb(35, 237, 86);" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-color: rgba(255,255,255,0.05); padding-bottom: 4px; margin-bottom: 4px;">
                                <ui:Label text="ASSET" style="font-size: 13px; color: grey; width: 60px;" />
                                <ui:Label text="TYPE" style="font-size: 13px; color: grey; width: 60px;" />
                                <ui:Label text="STATUS" style="font-size: 13px; color: grey; width: 50px;" />
                                <ui:Label text="COVERAGE" style="font-size: 13px; color: grey; width: 60px;" />
                                <ui:Label text="USE" style="font-size: 13px; color: grey; flex-grow: 1; unity-text-align: middle-right;" />
                            </ui:VisualElement>
                            <ui:ScrollView name="RS_AssetsList" style="flex-grow: 1; margin-bottom: 8px;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                            <ui:Button text="VIEW ALL ASSETS" style="background-color: rgba(255,255,255,0.05); border-width: 0; padding: 6px; color: grey; font-size: 14px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                            <!-- COL 2: ACTIVE RECON MISSIONS -->

                    <ui:VisualElement style="width: 48%; margin-right: 0; margin-right: 12px; flex-direction: column;">
                        <ui:VisualElement class="sub-panel" style="flex-grow: 1; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); min-height: 0;">
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                <ui:Label name="RS_MissionsHeaderTitle" text="ACTIVE RECON MISSIONS (7)" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; letter-spacing: 1px;" />
                                <ui:Label text="VIEW ALL" style="font-size: 14px; color: rgba(255, 255, 255, 0.5); letter-spacing: 1px; padding: 4px 8px; background-color: rgba(255,255,255,0.05); border-radius: 2px; cursor: link;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-color: rgba(255,255,255,0.05); padding-bottom: 4px; margin-bottom: 4px;">
                                <ui:Label text="MISSION" style="font-size: 13px; color: grey; width: 120px;" />
                                <ui:Label text="ASSET" style="font-size: 13px; color: grey; width: 70px;" />
                                <ui:Label text="OBJECTIVE" style="font-size: 13px; color: grey; flex-grow: 1;" />
                                <ui:Label text="AREA" style="font-size: 13px; color: grey; width: 80px;" />
                                <ui:Label text="STATUS" style="font-size: 13px; color: grey; width: 70px;" />
                                <ui:Label text="ETA" style="font-size: 13px; color: grey; width: 50px; unity-text-align: middle-right;" />
                            </ui:VisualElement>
                            <ui:ScrollView name="RS_MissionsList" style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- ROW 2 -->
                        <ui:VisualElement style="flex-direction: row; min-height: 280px; margin-bottom: 12px; justify-content: space-between;">
                            <!-- TASK NEW RECON MISSION -->

                    <ui:VisualElement class="sub-panel" style="width: 38%; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="TASK NEW RECON MISSION" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 8px;" />
                        
                        <ui:ScrollView style="flex-grow: 1;" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                            <ui:Label text="Mission Type" style="font-size: 13px; color: grey; margin-bottom: 4px;" />
                            <ui:DropdownField choices="Aerial Recon,Satellite Scan,SIGINT Intercept,HUMINT Network,Cyber Probe" value="Aerial Recon" style="min-height: 24px; background-color: rgba(1,1,1,0.2); border-width: 1px; border-color: rgba(255,255,255,0.1); margin-bottom: 12px; border-radius: 2px; font-size: 14px; color: grey;" class="custom-dropdown" />

                            <ui:Label text="Objective" style="font-size: 13px; color: grey; margin-bottom: 4px;" />
                            <ui:TextField value="Enter objective..." style="font-size: 14px; margin-bottom: 12px; min-height: 24px;" class="custom-textfield" />

                            <ui:Label text="Area of Interest" style="font-size: 13px; color: grey; margin-bottom: 4px;" />
                            <ui:DropdownField choices="Eastern Border,Capital City,Naval Base Alpha,Industrial Sector,Global Network" value="Eastern Border" style="min-height: 24px; background-color: rgba(1,1,1,0.2); border-width: 1px; border-color: rgba(255,255,255,0.1); margin-bottom: 12px; border-radius: 2px; font-size: 14px; color: grey;" class="custom-dropdown" />

                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 8px;">
                                <ui:VisualElement style="width: 48%;">
                                    <ui:Label text="Priority" style="font-size: 13px; color: grey; margin-bottom: 2px;" />
                                    <ui:DropdownField name="DrpReconPriority" choices="Low,Medium,High,Critical" value="Medium" style="min-height: 24px; background-color: rgba(1,1,1,0.2); border-width: 1px; border-color: rgba(255,255,255,0.1); border-radius: 2px; font-size: 14px; color: rgb(237, 180, 35);" class="custom-dropdown" />
                                </ui:VisualElement>
                                <ui:VisualElement style="width: 48%;">
                                    <ui:Label text="Assigned Asset" style="font-size: 13px; color: grey; margin-bottom: 2px;" />
                                    <ui:DropdownField choices="Auto Assign,Drone Sqn 1,Agent 'Viper',Satellite K-9" value="Auto Assign" style="min-height: 24px; background-color: rgba(1,1,1,0.2); border-width: 1px; border-color: rgba(255,255,255,0.1); border-radius: 2px; font-size: 14px; color: grey;" class="custom-dropdown" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            
                            <ui:Button name="BtnLaunchReconMission" text="LAUNCH MISSION" style="margin-top: 12px; background-color: rgba(35, 237, 86, 0.1); border-color: rgba(35, 237, 86, 0.3); border-width: 1px; border-radius: 4px; color: rgb(35, 237, 86); font-size: 15px; padding: 6px; -unity-font-style: bold;" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                            <!-- INTEL COLLECTION BREAKDOWN -->

                    <ui:VisualElement class="sub-panel" style="width: 58%; margin-right: 0; margin-right: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="INTELLIGENCE COLLECTION BREAKDOWN (This Month)" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 12px;" />
                        <ui:VisualElement style="flex-direction: row; flex-grow: 1; align-items: center;">
                            <ui:VisualElement style="width: 100px; height: 100px; margin-right: 16px; justify-content: center; align-items: center;">
                                <!-- Donut chart dynamically drawn -->
                                <ui:VisualElement name="RS_DonutChartCenter" style="position: absolute; width: 64px; height: 64px; border-radius: 32px; background-color: rgba(10, 14, 20, 1); align-items: center; justify-content: center;">
                                    <ui:Label name="RS_DonutTotalValue" text="$588M" style="font-size: 18px; color: white; -unity-font-style: bold;" />
                                    <ui:Label text="TOTAL SPENT" style="font-size: 12px; color: grey;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="RS_DonutBreakdownList" style="flex-grow: 1; justify-content: center;" />
                        </ui:VisualElement>
                        <!-- Budget adjusted in Economy Tab -->
                    </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- ROW 3 -->
                        <ui:VisualElement class="sub-panel" style="padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
<!-- RECENT RECON ACTIVITY -->
                <ui:VisualElement class="sub-panel" style="padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                    <ui:Label text="RECENT RECON ACTIVITY" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 12px;" />
                    <ui:VisualElement name="RS_RecentActivityContainer" style="flex-direction: row; flex-wrap: wrap; justify-content: space-between;" />
                </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- RIGHT COLUMN (Sidebar - 25%) -->
                    <ui:VisualElement style="width: 25%; flex-direction: column;">
                        <!-- LIVE INTELLIGENCE FEED -->

                    <ui:VisualElement style="width: 100%; margin-bottom: 12px; flex-direction: column;">
                        <ui:VisualElement class="sub-panel" style="flex-grow: 1; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); min-height: 0;">
                            <ui:Label text="LIVE INTELLIGENCE FEED" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 12px;" />
                            <ui:ScrollView name="RS_LiveFeedList" style="flex-grow: 1; margin-bottom: 8px;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                            <ui:Button text="VIEW FULL FEED" style="background-color: rgba(255,255,255,0.05); border-width: 0; padding: 6px; color: grey; font-size: 14px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                        <!-- RECON ANALYTICS -->

                    <ui:VisualElement class="sub-panel" style="width: 100%; margin-bottom: 12px; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
