                    <ui:VisualElement class="sub-panel" style="width: 25%; padding: 12px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                        <ui:Label text="QUICK ACTIONS" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                        <ui:VisualElement name="DA_QuickActions" style="flex-grow: 1; flex-direction: column; justify-content: space-between;" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
<!-- THREAT BOARD -->
            <ui:VisualElement name="PanelThreatBoard" style="display: none; height: 100%; flex-direction: column;">
                
                <ui:ScrollView style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:VisualElement style="flex-direction: column; padding-right: 6px;">

                        <!-- TOP KPI STRIP -->
                        <ui:VisualElement style="flex-direction: row; margin-bottom: 12px; flex-shrink: 0;">
                            <!-- Title block -->
                            <ui:VisualElement class="sub-panel" style="width: 28%; margin-right: 12px; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); flex-direction: row; align-items: center;">
                                <ui:VisualElement style="width: 44px; height: 44px; border-radius: 22px; background-color: rgba(255,255,255,0.05); align-items: center; justify-content: center; margin-right: 12px;">
                                    <ui:Label text="&#xf132;" class="fa-icon" style="color: white; font-size: 24px;" />
                                </ui:VisualElement>
                                <ui:VisualElement>
                                    <ui:Label text="THREAT ASSESSMENT" style="font-size: 18px; -unity-font-style: bold; color: white;" />
                                    <ui:Label text="Evaluate and prioritize threats to national security." style="font-size: 13px; color: grey; white-space: normal; margin-top: 2px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            
                            <!-- KPI Overall Threat -->
                            <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="OVERALL THREAT LEVEL" style="font-size: 13px; color: grey; margin-bottom: 6px;" />
                                <ui:Label name="TA_OverallLevel" text="HIGH" style="font-size: 24px; -unity-font-style: bold; color: rgb(255, 82, 82);" />
                                <ui:Label name="TA_OverallTrend" text="↗ vs last month" style="font-size: 13px; color: rgb(255, 82, 82); margin-top: 4px;" />
                            </ui:VisualElement>

                            <!-- KPI Active Threats -->
                            <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="ACTIVE THREATS" style="font-size: 13px; color: grey; margin-bottom: 6px;" />
                                <ui:Label name="TA_ActiveThreats" text="0" style="font-size: 24px; -unity-font-style: bold; color: white;" />
                                <ui:Label name="TA_ActiveTrend" text="↗ 0 new" style="font-size: 13px; color: rgb(255, 82, 82); margin-top: 4px;" />
                            </ui:VisualElement>

                            <!-- KPI Critical Threats -->
                            <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="CRITICAL THREATS" style="font-size: 13px; color: grey; margin-bottom: 6px;" />
                                <ui:Label name="TA_CriticalThreats" text="0" style="font-size: 24px; -unity-font-style: bold; color: white;" />
                                <ui:Label name="TA_CriticalTrend" text="No change" style="font-size: 13px; color: rgb(241, 196, 15); margin-top: 4px;" />
                            </ui:VisualElement>

                            <!-- KPI Countries of Concern -->
                            <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="COUNTRIES OF CONCERN" style="font-size: 13px; color: grey; margin-bottom: 6px;" />
                                <ui:Label name="TA_CountriesConcern" text="0" style="font-size: 24px; -unity-font-style: bold; color: white;" />
                                <ui:Label name="TA_CountriesTrend" text="↗ 0 new" style="font-size: 13px; color: rgb(255, 82, 82); margin-top: 4px;" />
                            </ui:VisualElement>

                            <!-- Report / Trend -->
                            <ui:VisualElement class="sub-panel" style="flex-grow: 1; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05); flex-direction: row; align-items: center; justify-content: space-between;">
                                <ui:VisualElement>
                                    <ui:Label text="THREAT TREND (30 DAYS)" style="font-size: 13px; color: grey; margin-bottom: 6px;" />
                                    <ui:Label name="TA_Trend30" text="RISING" style="font-size: 20px; -unity-font-style: bold; color: rgb(255, 82, 82);" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- ROW 1: Threat Matrix | Top Threats | Categories -->
                        <ui:VisualElement style="flex-direction: row; margin-bottom: 12px; flex-shrink: 0; min-height: 260px;">
                            <!-- Threat Matrix -->
                            <ui:VisualElement class="sub-panel" style="width: 28%; margin-right: 12px; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="THREAT MATRIX" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                                <ui:VisualElement name="TA_MatrixGrid" style="flex-grow: 1; flex-direction: column;" />
                            </ui:VisualElement>

                            <!-- Top Threats -->
                            <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="TOP THREATS" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                                <ui:VisualElement style="flex-direction: row; border-bottom-width: 1px; border-color: rgba(255,255,255,0.1); padding-bottom: 6px; margin-bottom: 6px;">
                                    <ui:Label text="THREAT" style="font-size: 13px; color: grey; width: 140px;" />
                                    <ui:Label text="CATEGORY" style="font-size: 13px; color: grey; flex-grow: 1;" />
                                    <ui:Label text="IMPACT" style="font-size: 13px; color: grey; width: 60px;" />
                                    <ui:Label text="LIKELIHOOD" style="font-size: 13px; color: grey; width: 60px;" />
                                    <ui:Label text="TREND" style="font-size: 13px; color: grey; width: 40px; -unity-text-align: middle-center;" />
                                    <ui:Label text="RISK LEVEL" style="font-size: 13px; color: grey; width: 60px; -unity-text-align: middle-right;" />
                                </ui:VisualElement>
                                <ui:ScrollView name="TA_TopThreatsList" style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                            </ui:VisualElement>

                            <!-- Threat Categories -->
                            <ui:VisualElement class="sub-panel" style="width: 25%; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="THREAT CATEGORIES" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; flex-grow: 1;">
                                    <ui:VisualElement style="width: 80px; height: 80px; border-radius: 40px; border-width: 8px; border-color: rgba(255,255,255,0.1); align-items: center; justify-content: center;">
                                        <ui:Label name="TA_CatDonut" text="0" style="font-size: 20px; color: white; -unity-font-style: bold;" />
                                        <ui:Label text="TOTAL" style="font-size: 12px; color: grey;" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="TA_CategoryList" style="flex-grow: 1; margin-left: 16px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- ROW 2: Regional Overview | Trend Chart | Countries of Concern -->
                        <ui:VisualElement style="flex-direction: row; margin-bottom: 12px; flex-shrink: 0; min-height: 280px;">
                            <!-- Regional Overview -->
                            <ui:VisualElement class="sub-panel" style="width: 28%; margin-right: 12px; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="REGIONAL THREAT OVERVIEW" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                                <ui:VisualElement name="TA_RegionList" style="flex-grow: 1;" />
                            </ui:VisualElement>

                            <!-- Threat Level Over Time -->
                            <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 12px;">
                                    <ui:Label text="THREAT LEVEL OVER TIME" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; letter-spacing: 1px;" />
                                    <ui:Label text="Last 90 Days" style="font-size: 14px; color: grey; background-color: rgba(255,255,255,0.05); padding-left: 6px; padding-right: 6px; border-radius: 2px;" />
                                </ui:VisualElement>
                                <ui:VisualElement name="TA_TrendChart" style="flex-grow: 1; flex-direction: row; align-items: flex-end; justify-content: space-between; padding-top: 20px;" />
                            </ui:VisualElement>

                            <!-- Countries of Concern -->
                            <ui:VisualElement class="sub-panel" style="width: 32%; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="COUNTRIES OF CONCERN" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                                <ui:VisualElement style="flex-direction: row; border-bottom-width: 1px; border-color: rgba(255,255,255,0.1); padding-bottom: 6px; margin-bottom: 6px;">
                                    <ui:Label text="COUNTRY" style="font-size: 13px; color: grey; width: 70px;" />
                                    <ui:Label text="CONCERN LEVEL" style="font-size: 13px; color: grey; width: 80px; -unity-text-align: middle-center;" />
                                    <ui:Label text="REASON" style="font-size: 13px; color: grey; flex-grow: 1;" />
                                    <ui:Label text="TREND" style="font-size: 13px; color: grey; width: 30px; -unity-text-align: middle-center;" />
                                </ui:VisualElement>
                                <ui:ScrollView name="TA_CountriesList" style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- ROW 3: Critical Threats | Mitigation | Recommendations -->
                        <ui:VisualElement style="flex-direction: row; flex-shrink: 0; min-height: 200px; margin-bottom: 12px;">
                            <!-- Critical Threats -->
                            <ui:VisualElement class="sub-panel" style="width: 45%; margin-right: 12px; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="CRITICAL THREATS (REQUIRING IMMEDIATE ATTENTION)" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px; white-space: normal;" />
                                <ui:VisualElement name="TA_CriticalCards" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; justify-content: space-between;" />
                            </ui:VisualElement>

                            <!-- Mitigation Progress -->
                            <ui:VisualElement class="sub-panel" style="flex-grow: 1; margin-right: 12px; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="MITIGATION PROGRESS" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                                <ui:ScrollView name="TA_MitigationList" style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                            </ui:VisualElement>

                            <!-- Recommendations -->
                            <ui:VisualElement class="sub-panel" style="width: 25%; padding: 16px; background-color: rgba(10, 14, 20, 0.95); border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.05);">
                                <ui:Label text="RECOMMENDATIONS" style="font-size: 15px; color: rgba(214, 223, 230, 0.6); -unity-font-style: bold; margin-bottom: 12px; letter-spacing: 1px;" />
                                <ui:ScrollView name="TA_RecommendationsList" style="flex-grow: 1;" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

