<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Global.uss" />

    <ui:VisualElement name="WPanelResearchInner"
        style="display: flex; flex-grow: 1; flex-direction: column; padding: 8px; padding-top: 6px;">

        <!-- ─── KPI OVERVIEW STRIP ──────────────────────────── -->
        <ui:VisualElement
            style="flex-direction: row; align-items: stretch; margin-bottom: 8px; flex-shrink: 0;">
            
            <ui:VisualElement class="sub-panel" style="flex-direction: row; align-items: center; padding: 12px; margin-right: 8px; flex-grow: 1;">
                <ui:Label text="&#xf0c3;" class="fa-icon" style="font-size: 25px; color: rgb(120,120,120); margin-right: 12px;" />
                <ui:VisualElement style="flex-direction: column;">
                    <ui:Label name="WResActiveProjects" text="4" style="font-size: 21px; color: white; -unity-font-style: bold;" />
                    <ui:Label text="ACTIVE PROJECTS" style="font-size: 11px; color: rgb(229, 153, 0); letter-spacing: 1px;" />
                    <ui:Label name="WResTotalCapacity" text="Max capacity reached" style="font-size: 10px; color: rgb(100,100,100);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="sub-panel" style="flex-direction: row; align-items: center; padding: 12px; margin-right: 8px; flex-grow: 1;">
                <ui:Label text="&#xf155;" class="fa-icon" style="font-size: 25px; color: rgb(120,120,120); margin-right: 12px;" />
                <ui:VisualElement style="flex-direction: column; flex-grow: 1;">
                    <ui:Label name="WResBudget" text="₦450M" style="font-size: 21px; color: white; -unity-font-style: bold;" />
                    <ui:Label text="RESEARCH BUDGET" style="font-size: 11px; color: rgb(180,180,180); letter-spacing: 1px;" />
                    <ui:Label text="12% of total budget" style="font-size: 10px; color: rgb(229, 153, 0);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="sub-panel" style="flex-direction: row; align-items: center; padding: 12px; flex-grow: 1;">
                <ui:Label text="&#xf085;" class="fa-icon" style="font-size: 25px; color: rgb(120,120,120); margin-right: 12px;" />
                <ui:VisualElement style="flex-direction: column; flex-grow: 1;">
                    <ui:Label name="WResEfficiency" text="92%" style="font-size: 21px; color: white; -unity-font-style: bold;" />
                    <ui:Label text="RESEARCH EFFICIENCY" style="font-size: 11px; color: rgb(180,180,180); letter-spacing: 1px;" />
                    <ui:Label text="Optimal conditions" style="font-size: 10px; color: rgb(35, 237, 86);" />
                    <ui:ProgressBar name="WResEfficiencyBar" value="92" style="height: 4px; margin-top: 4px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ─── MAIN BODY ──────────────────────────── -->
        <ui:VisualElement style="flex-direction: row; flex-grow: 1; min-height: 0;">

            <!-- LEFT: RESEARCH OVERVIEW & QUEUE -->
            <ui:VisualElement style="width: 220px; flex-shrink: 0; flex-direction: column; margin-right: 8px;">

                <!-- OVERVIEW CARD -->
                <ui:VisualElement class="sub-panel" style="padding: 12px; margin-bottom: 8px; align-items: center; flex-direction: column;">
                    <ui:Label text="RESEARCH OVERVIEW" style="font-size: 11px; color: rgb(120,120,120); letter-spacing: 1px; margin-bottom: 12px; -unity-text-align: middle-center;" />

                    <ui:VisualElement name="WResDonut" style="width: 120px; height: 120px; border-radius: 60px; align-items: center; justify-content: center; margin-bottom: 12px;">
                        <ui:Label text="ACTIVE" style="font-size: 10px; color: rgb(100,100,100); letter-spacing: 0.5px; -unity-text-align: middle-center;" />
                        <ui:Label name="WResDonutTotal" text="4" style="font-size: 25px; color: white; -unity-font-style: bold; -unity-text-align: middle-center;" />
                    </ui:VisualElement>

                    <!-- Legend -->
                    <ui:VisualElement style="width: 100%; flex-direction: column;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <ui:VisualElement style="flex-direction: row; align-items: center;">
                                <ui:VisualElement style="width: 10px; height: 10px; border-radius: 2px; background-color: rgb(35, 237, 86); margin-right: 6px;" />
                                <ui:Label text="Army Tech" style="font-size: 12px; color: rgb(160,160,160);" />
                            </ui:VisualElement>
                            <ui:Label name="WResLegArmy" text="2" style="font-size: 12px; color: white;" />
                        </ui:VisualElement>

                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <ui:VisualElement style="flex-direction: row; align-items: center;">
                                <ui:VisualElement style="width: 10px; height: 10px; border-radius: 2px; background-color: rgb(25, 127, 229); margin-right: 6px;" />
                                <ui:Label text="Air Force Tech" style="font-size: 12px; color: rgb(160,160,160);" />
                            </ui:VisualElement>
                            <ui:Label name="WResLegAF" text="1" style="font-size: 12px; color: white;" />
                        </ui:VisualElement>

                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                            <ui:VisualElement style="flex-direction: row; align-items: center;">
                                <ui:VisualElement style="width: 10px; height: 10px; border-radius: 2px; background-color: rgb(25, 127, 229); margin-right: 6px;" />
                                <ui:Label text="Naval Tech" style="font-size: 12px; color: rgb(160,160,160);" />
                            </ui:VisualElement>
                            <ui:Label name="WResLegNavy" text="1" style="font-size: 12px; color: white;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- RESEARCH QUEUE -->
                <ui:VisualElement class="sub-panel" style="padding: 12px; flex-grow: 1; flex-direction: column;">
                    <ui:Label text="RESEARCH QUEUE" style="font-size: 11px; color: rgb(229, 153, 0); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 12px;" />
                    <ui:ScrollView name="WResQueueList" mode="Vertical" show-horizontal-scroller="False" style="flex-grow: 1;" />
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- CENTER: AVAILABLE RESEARCH GRID -->
            <ui:VisualElement style="flex-grow: 1; flex-direction: column; min-width: 0; margin-right: 8px;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <ui:Label text="AVAILABLE RESEARCH" style="font-size: 12px; color: rgb(229, 153, 0); -unity-font-style: bold; letter-spacing: 1px;" />
                    
                    <!-- Filter Tabs -->
                    <ui:VisualElement style="flex-direction: row;">
                        <ui:Button name="WResFilterAll" text="ALL" class="button-premium active-tab" style="height: 20px; font-size: 11px; margin-left: 4px;" />
                        <ui:Button name="WResFilterArmy" text="ARMY" class="button-premium" style="height: 20px; font-size: 11px; margin-left: 4px;" />
                        <ui:Button name="WResFilterAir" text="AIR FORCE" class="button-premium" style="height: 20px; font-size: 11px; margin-left: 4px;" />
                        <ui:Button name="WResFilterNavy" text="NAVY" class="button-premium" style="height: 20px; font-size: 11px; margin-left: 4px;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:ScrollView mode="Vertical" show-horizontal-scroller="False" style="flex-grow: 1;">
                    <ui:VisualElement name="WResAvailableGrid" style="flex-direction: row; flex-wrap: wrap; justify-content: flex-start; align-content: flex-start;" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- RIGHT: TECH TREE & BREAKTHROUGHS -->
            <ui:VisualElement style="width: 260px; flex-shrink: 0; flex-direction: column;">

                <!-- TECHNOLOGY TREE SUMMARY -->
                <ui:VisualElement class="sub-panel" style="padding: 12px; margin-bottom: 8px; flex-direction: column; align-items: center;">
                    <ui:Label text="TECHNOLOGY TREE" style="font-size: 12px; color: rgb(229, 153, 0); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 12px; align-self: flex-start;" />
                    
                    <ui:Label text="CURRENT TIER" style="font-size: 10px; color: rgb(120,120,120); letter-spacing: 1px; margin-bottom: 4px;" />
                    <ui:Label name="WResCurrentTier" text="Tier 4: Modern Era" style="font-size: 18px; color: white; -unity-font-style: bold; margin-bottom: 12px;" />
                    
                    <ui:Label text="Progress to Tier 5" style="font-size: 11px; color: rgb(160,160,160); margin-bottom: 6px;" />
                    <ui:ProgressBar name="WResTierProgress" value="45" style="height: 8px; width: 100%; margin-bottom: 12px;" />
                    
                    <ui:Button name="WResBtnFullTree" text="VIEW FULL TECH TREE" class="button-premium" style="height: 28px; font-size: 12px; width: 100%;" />
                </ui:VisualElement>

                <!-- LATEST BREAKTHROUGHS -->
                <ui:VisualElement class="sub-panel" style="padding: 12px; flex-grow: 1; flex-direction: column;">
                    <ui:Label text="LATEST BREAKTHROUGHS" style="font-size: 12px; color: rgb(229, 153, 0); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 12px;" />
                    
                    <ui:ScrollView name="WResBreakthroughsList" mode="Vertical" show-horizontal-scroller="False" style="flex-grow: 1;" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
